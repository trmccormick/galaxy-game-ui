<section class="landing-hero">
  <div class="hero-content">
    <%= image_tag "logos/wormhole_transit_consortium.png", alt: "Wormhole Transit Consortium Logo", class: "hero-logo" %>
    <h1>Galaxy Game</h1>
    <p class="hero-tagline">Navigate the wormhole network. Expand your empire.</p>
    
    <!-- Post-Snap Status Banner -->
    <% if @post_snap_status %>
      <div class="snap-banner">
        <span class="snap-indicator">⚠ POST-SNAP STATE</span>
        <p>Snap event detected: <%= @post_snap_status[:snap_event_date]&.to_time&.strftime("%B %d, %Y") %></p>
        <p>AWS Reconstrucation Complete: <%= @post_snap_status[:aws_reconstruction_date]&.to_time&.strftime("%B %d, %Y") %></p>
      </div>
    <% end %>

    <%= form_with url: landing_enter_path, method: :post, local: true do |f| %>
      <div class="system-selector">
        <label for="system-select">Select System:</label>
        <%= f.select :system, 
            options_for_select([
              ["Sol (Home)", "SOL"],
              ["Eden (Outpost)", "EDEN"],
              ["System B", "SYS_B"]
            ], @current_system_id),
            { id: "system-select", class: "system-select" } %>
      </div>
      
      <%= f.submit "Enter Game", class: "btn btn-primary btn-lg enter-btn" %>
    <% end %>
  </div>
</section>

<section class="landing-systems">
  <h2>Known Systems</h2>
  <div class="systems-grid">
    <% @systems.each do |system| %>
      <div class="system-card stability-<%= system_stability_class(system) %>">
        <div class="system-image">
            <span class="system-id"><%= system[:id] %></span>
        </div>
        <h3><%= system[:name] %></h3>
        <p class="system-description"><%= system_identifier_description(system[:id]) %></p>
        <ul class="system-facts">
          <% if system[:id] == "SOL" %>
            <li>Home System</li>
            <li>Mass: <%= number_with_delimiter(system[:system_mass]) %> tons</li>
            <li>Wormhole Connections: 2</li>
          <% elsif system[:id] == "EDEN" %>
            <li>AWS Outpost</li>
            <li>Reconnected via Artificial Wormhole</li>
            <li>Status: Operational</li>
          <% else %>
            <li>Natural Wormhole Access</li>
            <li>Mass: <%= number_with_delimiter(system[:system_mass]) %> tons</li>
            <li>Stability: <span class="stability-index"><%= (MockDataHelper.wormholes.find { |w| w[:system_b] == system[:name] }&.dig(:stability_index) || 0).round(2) %></span></li>
          <% end %>
        </ul>
        <span class="stability-badge stability-<%= system_stability_class(system) %>">
          <%= system_stability_class(system).titleize %>
        </span>
      </div>
    <% end %>
  </div>
</section>

<!-- EM Economy Status -->
<section class="landing-em-status">
  <h2>EM Economy Status</h2>
  <div class="em-dashboard">
    <div class="em-card">
      <h3>Total EM Reserves</h3>
      <p class="em-amount"><%= number_with_delimiter(@em_status[:total_em_reserves]) %> EM</p>
    </div>
    <div class="em-card harvest">
      <h3>Daily Harvest</h3>
      <p class="em-amount positive">+<%= number_with_delimiter(@em_status[:daily_harvest_rate]) %> EM/day</p>
    </div>
    <div class="em-card consumption">
      <h3>Daily Consumption</h3>
      <p class="em-amount negative"><%= number_with_delimiter(@em_status[:daily_consumption]) %> EM/day</p>
    </div>
    <div class="em-card net-flow">
      <h3>Net Daily Flow</h3>
      <p class="em-amount <%= @em_status[:net_daily_flow] >= 0 ? 'positive' : 'negative' %>"><%= @em_status[:net_daily_flow] %> EM/day</p>
    </div>
    <div class="em-card critical">
      <h3>Days Until Critical</h3>
      <p class="em-amount critical"><%= @em_status[:days_until_critical] %></p>
    </div>
  </div>
</section>

<section class="landing-login">
  <div class="login-container">
    <h2>Establish Connection</h2>
    <p>Enter your credentials to access the network</p>
    
    <%= form_with url: session_path, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, class: "form-input" %>
      </div>
      
      <div class="form-group">
        <%= f.label :password %>
        <%= f.password_field :password, class: "form-input" %>
      </div>
      
      <%= f.submit "Login", class: "btn btn-primary btn-lg" %>
    <% end %>
  </div>
</section>

<!-- Admin Interface (if admin) -->
<% if @hammer_protocol %>
<section class="landing-admin">
  <h2>Hammer Protocol Status</h2>
  <div class="admin-panel">
    <p>Snap Trigger Threshold: <%= @hammer_protocol[:system_b_natural_wh][:snap_trigger_threshold] %></p>
    <p>Current Transit Mass: <%= @hammer_protocol[:system_b_natural_wh][:current_transit_mass] %></p>
    <p>Snap Ready: <%= @hammer_protocol[:system_b_natural_wh][:snap_ready] ? 'Yes' : 'No' %></p>
  </div>
</section>
<% end %>

<!-- Helper methods for the view -->
<script>
function updateSystemDescription(system) {
  const descriptions = {
    SOL: "Your home system. Stable, resourced.",
    EDEN: "A frontier outpost. Opportunity awaits.",
    SYS_B: "Unknown territory. Risk and reward."
  };
  return descriptions[system] || '';
}
</script>
