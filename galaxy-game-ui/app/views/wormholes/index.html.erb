<div class="wormhole-navigator">
  <!-- EM Economy Status Bar -->
  <div class="em-economy-bar">
    <div class="em-stat">
      <span class="label">Total Reserves:</span>
      <span class="value"><%= number_with_delimiter(@em_status[:total_em_reserves]) %> EM</span>
    </div>
    
    <div class="em-stat harvest">
      <span class="label">Daily Harvest:</span>
      <span class="value positive">+<%= number_with_delimiter(@em_status[:daily_harvest_rate]) %></span>
    </div>
    
    <div class="em-stat consumption">
      <span class="label">Daily Consumption:</span>
      <span class="value negative"><%= number_with_delimiter(@em_status[:daily_consumption]) %></span>
    </div>
    
    <div class="em-stat net-flow <%= @em_status[:net_daily_flow] >= 0 ? 'positive' : 'negative' %>">
      <span class="label">Net Flow:</span>
      <span class="value"><%= number_with_delimiter(@em_status[:net_daily_flow]) %>/day</span>
    </div>
    
    <div class="em-stat critical <%= @em_status[:days_until_critical] < 30 ? 'critical' : '' %>">
      <span class="label">Days Until Critical:</span>
      <span class="value"><%= @em_status[:days_until_critical] %></span>
    </div>
  </div>

  <!-- Main Network Visualization -->
  <div class="wormhole-network-container">
    <h2>Wormhole Network</h2>
    
    <% natural_wh = @wormholes.find { |w| w[:natural] } || {} %>
    <% aws_wh = @wormholes.find { |w| !w[:natural] } || {} %>
    
    <svg id="network-svg" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg">
      <rect width="100%" height="100%" fill="var(--bg)" />
      
      <!-- System Nodes -->
      <g class="system-nodes">
        <circle cx="400" cy="250" r="60" fill="var(--panel)" stroke="var(--accent)" stroke-width="3" />
        <text x="400" y="250" text-anchor="middle" dominant-baseline="central" fill="var(--text)" font-size="18" font-weight="bold">SOL</text>
        
        <circle cx="200" cy="100" r="50" fill="var(--panel)" stroke="<%= natural_wh[:stability_index] >= 0.8 ? 'var(--green)' : (natural_wh[:stability_index] >= 0.5 ? '#ffa500' : 'var(--red)') %>" stroke-width="3" />
        <text x="200" y="100" text-anchor="middle" dominant-baseline="central" fill="var(--text)" font-size="16">SYS B</text>
        
        <circle cx="600" cy="100" r="50" fill="var(--panel)" stroke="var(--accent)" stroke-width="3" />
        <text x="600" y="100" text-anchor="middle" dominant-baseline="central" fill="var(--text)" font-size="16">EDEN</text>
      </g>
      
      <!-- Wormhole Connections -->
      <g class="wormhole-links">
        <line x1="370" y1="235" x2="240" y2="125" 
              stroke="<%= natural_wh[:stability_index] >= 0.8 ? 'var(--green)' : (natural_wh[:stability_index] >= 0.5 ? '#ffa500' : 'var(--red)') %>" 
              stroke-width="4" stroke-dasharray="10,5" />
        <text x="290" y="170" fill="<%= natural_wh[:stability_index] >= 0.8 ? 'var(--green)' : (natural_wh[:stability_index] >= 0.5 ? '#ffa500' : 'var(--red)') %>" font-size="12">Natural WH</text>
        
        <line x1="430" y1="235" x2="560" y2="125" stroke="var(--accent)" stroke-width="4" />
        <text x="510" y="170" fill="var(--accent)" font-size="12">Artificial WH (AWS)</text>
      </g>
    </svg>
  </div>

  <!-- Wormhole Details -->
  <div class="wormhole-details-grid">
    <div class="wormhole-panel natural">
      <h3><%= natural_wh[:name] || 'Natural Wormhole' %></h3>
      <div class="wh-stats">
        <div class="stat-row">
          <span class="label">Stability:</span>
          <div class="stability-bar">
            <div class="stability-fill" style="width: <%= (natural_wh[:stability_index] || 0.68) * 100 %>%"></div>
          </div>
        </div>
        <p><strong>Mass Limit:</strong> <%= (natural_wh[:mass_limit] || 37).round %> tons</p>
        <p><strong>EM Reserves:</strong> <%= number_with_delimiter(natural_wh[:em_reserves] || 8500) %> EM</p>
        <p><strong>Harvest Rate:</strong> +<%= natural_wh[:em_harvest_rate] || 150 %> EM/1000T</p>
        <p class="risk-<%= (natural_wh[:snap_risk_level] || 'caution').downcase %>">Snap Risk: <%= (natural_wh[:snap_risk_level] || 'caution').upcase %></p>
      </div>
    </div>
    
    <div class="wormhole-panel artificial">
      <h3><%= aws_wh[:name] || 'Artificial Wormhole' %></h3>
      <div class="wh-stats">
        <p><strong>Stability:</strong> <%= (aws_wh[:stability_index] || 0.95) * 100 %>% (AWS Stabilized)</p>
        <p><strong>Mass Limit:</strong> <%= (aws_wh[:mass_limit] || 57).round %> tons</p>
        <p><strong>EM Reserves:</strong> <%= number_with_delimiter(aws_wh[:em_reserves] || 15000) %> EM</p>
        <p class="success">AWS Operational: Yes (2 Stabilizers)</p>
        <p class="success">Snap Risk: None (Artificial)</p>
      </div>
    </div>
  </div>

  <!-- Pathfinder -->
  <div class="pathfinder-container">
    <h2>Pathfinder</h2>
    <%= form_with url: wormholes_path, method: :get, local: true do |f| %>
      <div class="pathfinder-form">
        <%= f.select :source, options_for_select([["Sol", "SOL"], ["System B", "SYS_B"]], @current_location), { class: "select-input" } %>
        <%= f.select :destination, options_for_select([["System B", "SYS_B"], ["Eden", "EDEN"]]), { class: "select-input" } %>
        <%= f.submit "Find Route", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <!-- Hammer Protocol (Admin Only) -->
  <% if @hammer_protocol %>
  <div class="hammer-protocol-container">
    <h2 class="danger-header">Hammer Protocol — Emergency Wormhole Control</h2>
    <div class="admin-panel danger-border">
      <p><strong>Snap Status:</strong> <%= @hammer_protocol[:system_b_natural_wh][:snap_ready] ? 'READY' : 'Not Ready' %></p>
      <p>Threshold: <%= @hammer_protocol[:system_b_natural_wh][:snap_trigger_threshold] %> tons</p>
      <% unless @hammer_protocol[:system_b_natural_wh][:snap_ready] %>
        <%= button_to "⚠️ TRIGGER SNAP EVENT", trigger_snap_wormholes_path(wormhole_id: 1), method: :post, form: { data: { turbo_confirm: "This will destroy the natural wormhole. Continue?" } }, class: "btn btn-danger btn-lg disabled" %>
      <% end %>
    </div>
  </div>
  <% end %>
</div>

<style>
.wormhole-navigator { background: var(--bg); min-height: 100vh; padding: 20px; }
.em-economy-bar { display: flex; justify-content: space-between; gap: 16px; padding: 16px; background: var(--panel); margin-bottom: 30px; flex-wrap: wrap; }
.em-stat { background: var(--bg); padding: 12px; border-radius: 4px; min-width: 150px; text-align: center; }
.em-stat .label { color: var(--muted); font-size: 12px; display: block; margin-bottom: 4px; }
.em-stat .value { font-size: 18px; font-weight: bold; }
.em-stat .positive { color: var(--green); }
.em-stat .negative, .em-stat .critical { color: var(--red); animation: pulse-critical 2s infinite; }
.wormhole-network-container h2 { color: var(--text); margin-bottom: 20px; }
#wormhole-svg { width: 100%; max-width: 800px; height: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 4px; margin-bottom: 30px; }
.wormhole-details-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 20px; margin-bottom: 40px; }
.wormhole-panel { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; }
.wormhole-panel.natural { border-left: 4px solid #ffa500; }
.wormhole-panel.artificial { border-left: 4px solid var(--accent); }
.wh-stats .stat-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; p { margin: 0; color: var(--text); } }
.stability-bar { width: 100%; height: 8px; background: var(--panel2); border-radius: 4px; .stability-fill { height: 100%; transition: width 0.3s ease; } }
.success { color: var(--green) !important; }
.pathfinder-container { padding: 30px; background: var(--panel); margin-bottom: 30px; h2 { color: var(--text); margin-bottom: 16px; } }
.pathfinder-form { display: flex; gap: 12px; select { padding: 8px; background: var(--bg); border: 1px solid var(--line); color: var(--text); border-radius: 4px; } }
.hammer-protocol-container { padding: 30px; background: rgba(255, 0, 0, 0.05); h2.danger-header { color: var(--red); margin-bottom: 16px; } .admin-panel { background: var(--panel); border: 2px solid var(--red); padding: 24px; p { color: var(--text); margin-bottom: 8px; } } }
@keyframes pulse-critical { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
@media (max-width: 768px) { .em-economy-bar { flex-direction: column; } .wormhole-details-grid { grid-template-columns: 1fr !important; } }
@media (max-width: 375px) { .pathfinder-form { flex-direction: column; } }
@media (min-width: 1200px) { .wormhole-details-grid { grid-template-columns: repeat(2, 1fr) !important; } }
</style>
