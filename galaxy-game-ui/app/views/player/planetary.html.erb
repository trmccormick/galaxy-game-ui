<!-- ===== Planetary Shell (sidebar + map + data panel) ===== -->
    <div class="flex flex-1 overflow-hidden">

        <!-- Sidebar: Layer Controls -->
        <aside class="w-56 border-r border-[rgba(0,212,255,0.1)] shrink-0 overflow-y-auto" style="background: var(--gg-bg-dark); padding: var(--gg-spacing-md) 0;">
            <nav>
                <!-- Navigation -->
                <div class="px-4 pb-3">
                    <h3 class="text-[var(--gg-text-dim)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-bottom: 0.5rem;">Navigation</h3>
                    <%= link_to "← Back to Dashboard", dashboard_path,
                          class: "block w-full text-left rounded px-3 py-2 bg-[rgba(0,212,255,0.08)] hover:bg-[rgba(0,212,255,0.15)] transition-colors text-[var(--gg-text-secondary)] hover:text-[var(--gg-primary)] text-xs" %>
                </div>

                <!-- Map Layers -->
                <div class="px-4 pb-3">
                    <h3 class="text-[var(--gg-text-dim)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-bottom: 0.5rem;">Map Layers</h3>
                    <div class="flex flex-col gap-1">
                        <button class="layer-btn active gg-nav-link" data-layer="terrain" style="text-align: left; font-size: var(--gg-font-sm);">Terrain</button>
                        <button class="layer-btn gg-nav-link" data-layer="water" style="text-align: left; font-size: var(--gg-font-sm);">Hydrosphere</button>
                        <button class="layer-btn gg-nav-link" data-layer="biomes" style="text-align: left; font-size: var(--gg-font-sm);">Biomes</button>
                        <button class="layer-btn gg-nav-link" data-layer="features" style="text-align: left; font-size: var(--gg-font-sm);">Features</button>
                        <button class="layer-btn gg-nav-link" data-layer="temperature" style="text-align: left; font-size: var(--gg-font-sm);">Temperature</button>
                        <button class="layer-btn gg-nav-link" data-layer="rainfall" style="text-align: left; font-size: var(--gg-font-sm);">Rainfall</button>
                        <button class="layer-btn gg-nav-link" data-layer="resources" style="text-align: left; font-size: var(--gg-font-sm);">Resources</button>
                    </div>
                </div>
            </nav>
        </aside>

        <!-- Main content area: Map -->
        <main class="flex-1 overflow-y-auto p-6" style="background: #0a0e1a;">
            <div id="canvasWrapper" style="position: relative; width: 100%; height: calc(100vh - 200px);">
                <div id="mapOverlay" style="position: absolute; top: 0; left: 0; right: 0; z-index: 10; pointer-events: none;">
                    <div id="mapTitle" style="color: var(--gg-text-primary); font-size: var(--gg-font-sm); padding: 0.5rem 1rem; background: rgba(10,14,26,0.8);"><%= @planet_name %> - PLANETARY MAP</div>
                </div>
                <div id="canvasScroller" style="width: 100%; height: 100%; overflow: auto;">
                    <div id="canvasContainer" style="min-width: 800px; min-height: 400px; display: flex; align-items: center; justify-content: center;">
                        <canvas id="planetCanvas" width="800" height="400" style="background: #000;"></canvas>
                    </div>
                </div>
                <div id="mapControls" style="position: absolute; bottom: 1rem; right: 1rem; display: flex; gap: 1rem; z-index: 20;">
                    <div class="rounded bg-[var(--gg-bg-surface)] border border-[rgba(0,212,255,0.2)] px-3 py-2 text-xs">
                        <label style="color: var(--gg-text-secondary);">Zoom: <span id="zoomValue" class="text-[var(--gg-primary)]">1.0x</span></label>
                        <input type="range" id="zoom" min="0.5" max="4" step="0.1" value="1" style="width: 120px; margin-top: 0.25rem;">
                    </div>
                    <button id="resetViewBtn" class="rounded bg-[rgba(0,212,255,0.1)] hover:bg-[rgba(0,212,255,0.2)] transition-colors text-[var(--gg-text-secondary)] hover:text-[var(--gg-primary)] px-3 py-2 text-xs" title="Reset view to center">&#x2302; Reset</button>
                </div>
            </div>
        </main>

        <!-- Right Panel: Data Panel -->
        <aside id="dataPanel" style="background: var(--gg-bg-surface); color: var(--gg-text-primary); width: 320px; border-left: 1px solid rgba(0,212,255,0.1); padding: 1.5rem 1rem; overflow-y: auto;">
            <!-- Atmosphere Section -->
            <div class="data-section mb-6">
                <h3 class="text-[var(--gg-primary)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-bottom: 0.75rem;">Atmosphere</h3>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Pressure:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="atmo-pressure">1.00 atm</span>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Temperature:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="atmo-temp">288.0 K</span>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Total Mass:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="atmo-mass">5.15e19 kg</span>
                </div>
                <!-- Composition -->
                <h4 class="subsection text-[var(--gg-text-dim)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-top: 1rem; margin-bottom: 0.5rem;">Composition</h4>
                <div id="atmo-composition">
                    <div class="data-row mb-1 flex justify-between">
                        <span class="data-label" style="color: var(--gg-text-secondary);">N<sub>2</sub>:</span>
                        <span class="data-value text-[var(--gg-primary)]">78.0%</span>
                    </div>
                    <div class="data-row mb-1 flex justify-between">
                        <span class="data-label" style="color: var(--gg-text-secondary);">O<sub>2</sub>:</span>
                        <span class="data-value text-[var(--gg-primary)]">21.0%</span>
                    </div>
                    <div class="data-row mb-1 flex justify-between">
                        <span class="data-label" style="color: var(--gg-text-secondary);">Ar:</span>
                        <span class="data-value text-[var(--gg-primary)]">0.93%</span>
                    </div>
                </div>
            </div>

            <!-- Biosphere Section -->
            <div class="data-section mb-6">
                <h3 class="text-[var(--gg-primary)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-bottom: 0.75rem;">Biosphere</h3>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Biodiversity:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="bio-diversity">65.0%</span>
                </div>
                <div class="progress-bar mb-2 rounded-full overflow-hidden" style="background: rgba(0,212,255,0.1); height: 8px;">
                    <div id="bio-diversity-bar" class="progress-fill" style="width: 65%; background: var(--gg-accent-success); height: 100%;"></div>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Habitability:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="bio-habitability">92.0%</span>
                </div>
                <div class="progress-bar mb-2 rounded-full overflow-hidden" style="background: rgba(0,212,255,0.1); height: 8px;">
                    <div id="bio-habitability-bar" class="progress-fill" style="width: 92%; background: var(--gg-accent-success); height: 100%;"></div>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Life Forms:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="bio-lifeforms">Extensive</span>
                </div>
            </div>

            <!-- Geosphere Section -->
            <div class="data-section mb-6">
                <h3 class="text-[var(--gg-primary)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-bottom: 0.75rem;">Geosphere</h3>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Geological Activity:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="geo-activity">50/100</span>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Tectonic Active:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="geo-tectonic">Yes</span>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Core Mass:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="geo-core">1.33e23 kg</span>
                </div>
            </div>

            <!-- Hydrosphere Section -->
            <div class="data-section mb-6">
                <h3 class="text-[var(--gg-primary)] uppercase tracking-widest text-[10px]" style="letter-spacing: 0.1em; margin-bottom: 0.75rem;">Hydrosphere</h3>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Liquid Coverage:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="hydro-coverage">71.0%</span>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Primary Liquid:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="hydro-ocean">H<sub>2</sub>O</span>
                </div>
                <div class="data-row mb-2 flex justify-between">
                    <span class="data-label" style="color: var(--gg-text-secondary);">Total Liquid Mass:</span>
                    <span class="data-value text-[var(--gg-primary)]" id="hydro-ice">1.4e21 kg</span>
                </div>
            </div>
        </aside>
    </div>

    <!-- Bottom Panel: Console -->
    <footer style="border-top: 1px solid rgba(0,212,255,0.1); padding: 0.75rem 1rem; background: var(--gg-bg-surface);">
        <div id="console" style="font-family: monospace; font-size: 11px; color: var(--gg-text-secondary); max-height: 80px; overflow-y: auto;">
            <div class="console-line info" style="color: var(--gg-primary);">&gt; planetary monitoring system initialized for <%= @planet_name %></div>
        </div>
    </footer>

