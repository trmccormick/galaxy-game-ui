<%# Planetary View — layout and markup for the Player Dashboard shell. %>
<%# Layout: header line with body facts, toolbar above map, map center, data panel right. %>
<%# The shared dashboard layout wraps this in <main>; no nested sidebar/main/footer here. %>

<%= stylesheet_link_tag 'pages/player_planetary', "data-turbo-track": "reload" %>

<!-- Header line with body facts -->
<div class="planetary-header">
  <h1 class="planetary-title"><%= @planet_name %> — PLANETARY</h1>
  <div class="planetary-facts">
    <%= @planet_type %> |
    Radius: <%= number_to_human(@radius, precision: 2) %> m |
    Gravity: <%= number_with_precision(@gravity, precision: 3) %>g |
    Temp: <%= number_with_precision(288.0, precision: 1) %>K
  </div>
</div>

<!-- Toolbar above the map -->
<div class="planetary-toolbar">
  <!-- Layer buttons -->
  <div class="layer-selector">
    <button class="layer-btn active" data-layer="terrain">Terrain</button>
    <button class="layer-btn" data-layer="water">Hydrosphere</button>
    <button class="layer-btn" data-layer="biomes">Biomes</button>
    <button class="layer-btn" data-layer="features">Features</button>
    <button class="layer-btn" data-layer="temperature">Temperature</button>
    <button class="layer-btn" data-layer="rainfall">Rainfall</button>
    <button class="layer-btn" data-layer="resources">Resources</button>
  </div>

  <!-- Zoom and reset -->
  <div class="planetary-controls">
    <div class="control-group">
      <label>Zoom: <span id="zoomValue" class="value-display">1.0x</span></label>
      <input type="range" id="zoom" min="0.5" max="4" step="0.1" value="1">
    </div>
    <button id="resetViewBtn" class="control-btn" title="Reset view to center">&#x2302; Reset</button>
  </div>
</div>

<!-- Map and data panel area -->
<div class="planetary-body">
  <!-- Map canvas -->
  <div id="canvasWrapper" class="planetary-map">
    <div id="mapOverlay" class="map-overlay">
      <div id="mapTitle"><%= @planet_name %> — PLANETARY MAP</div>
    </div>
    <div id="canvasScroller" class="map-scroller">
      <div id="canvasContainer" class="map-container">
        <canvas id="planetCanvas" width="800" height="400"></canvas>
      </div>
    </div>
  </div>

  <!-- Right Panel: Data Panel -->
  <aside id="dataPanel" class="planetary-data-panel">
    <!-- Atmosphere Section -->
    <div class="data-section mb-6">
      <h3 class="section-title">Atmosphere</h3>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Pressure:</span>
        <span class="data-value" id="atmo-pressure"><%= number_with_precision(@atmosphere[:pressure], precision: 2) %> atm</span>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Temperature:</span>
        <span class="data-value" id="atmo-temp"><%= number_with_precision(@atmosphere[:temperature], precision: 1) %> K</span>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Total Mass:</span>
        <span class="data-value" id="atmo-mass"><%= number_to_human(@atmosphere[:total_mass], precision: 2) %> kg</span>
      </div>
      <!-- Composition -->
      <h4 class="subsection-title">Composition</h4>
      <div id="atmo-composition">
        <% @atmosphere[:composition].each do |gas, percentage| %>
          <div class="data-row mb-1 flex justify-between">
            <span class="data-label"><%= gas %>:</span>
            <span class="data-value"><%= number_with_precision(percentage, precision: 2) %>%</span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Biosphere Section -->
    <div class="data-section mb-6">
      <h3 class="section-title">Biosphere</h3>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Biodiversity:</span>
        <span class="data-value" id="bio-diversity"><%= number_with_precision(@biosphere[:biodiversity], precision: 1) %>%</span>
      </div>
      <div class="progress-bar mb-2 rounded-full overflow-hidden">
        <div id="bio-diversity-bar" class="progress-fill" style="width: <%= @biosphere[:biodiversity] %>; background: var(--gg-accent-success); height: 100%;"></div>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Habitability:</span>
        <span class="data-value" id="bio-habitability"><%= number_with_precision(@biosphere[:habitability], precision: 1) %>%</span>
      </div>
      <div class="progress-bar mb-2 rounded-full overflow-hidden">
        <div id="bio-habitability-bar" class="progress-fill" style="width: <%= @biosphere[:habitability] %>; background: var(--gg-accent-success); height: 100%;"></div>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Life Forms:</span>
        <span class="data-value" id="bio-lifeforms"><%= @biosphere[:life_forms] %></span>
      </div>
    </div>

    <!-- Geosphere Section -->
    <div class="data-section mb-6">
      <h3 class="section-title">Geosphere</h3>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Geological Activity:</span>
        <span class="data-value" id="geo-activity"><%= @geosphere[:geological_activity] %>/100</span>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Tectonic Active:</span>
        <span class="data-value" id="geo-tectonic"><%= @geosphere[:tectonic_active] ? 'Yes' : 'No' %></span>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Core Mass:</span>
        <span class="data-value" id="geo-core"><%= number_to_human(@geosphere[:core_mass], precision: 2) %> kg</span>
      </div>
    </div>

    <!-- Hydrosphere Section -->
    <div class="data-section mb-6">
      <h3 class="section-title">Hydrosphere</h3>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Liquid Coverage:</span>
        <span class="data-value" id="hydro-coverage"><%= number_with_precision(@hydrosphere[:liquid_coverage], precision: 1) %>%</span>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Primary Liquid:</span>
        <span class="data-value" id="hydro-ocean"><%= @hydrosphere[:primary_liquid] %></span>
      </div>
      <div class="data-row mb-2 flex justify-between">
        <span class="data-label">Total Liquid Mass:</span>
        <span class="data-value" id="hydro-mass"><%= number_to_human(@hydrosphere[:total_liquid_mass], precision: 2) %> kg</span>
      </div>
    </div>
  </aside>
</div>

<!-- MOCK DATA: Representative Earth data ported from main app (galaxyGame/galaxy_game). -->
<!-- Prototype does NOT process game data; these values are display-only for layout work. -->
<script type="application/json" id="monitor-data">
<%= raw({
  planet_id: 1,
  planet_name: @planet_name,
  planet_type: @planet_type,
  surface_temperature: 288,
  atmosphere_temperature: 288,
  atmosphere_pressure: 1.0,
  atmospheric_composition: { "N2" => 78.0, "O2" => 21.0, "Ar" => 0.93 },
  terrain_data: @terrain_data,
  planet_data: {
    name: @planet_name,
    type: @planet_type,
    atmosphere: { pressure: @atmosphere[:pressure], temperature: @atmosphere[:temperature], total_mass: @atmosphere[:total_mass], composition: @atmosphere[:composition] },
    surface_temperature: 288,
    geological_activity: @geosphere[:geological_activity],
    gravity: @gravity,
    geosphere_attributes: { geological_activity: @geosphere[:geological_activity], tectonic_active: @geosphere[:tectonic_active], core_mass: @geosphere[:core_mass] },
    liquid_name: @hydrosphere[:primary_liquid],
    water_coverage: @hydrosphere[:liquid_coverage],
    has_biosphere: true,
    has_hydrosphere: true,
    has_atmosphere: true
  },
  geosphere_present: true,
  biosphere_present: true,
  hydrosphere_present: true,
  atmosphere_present: true,
  terrain_map_present: false,
  available_layers: { terrain: true, water: true, biomes: true, features: true, temperature: true, rainfall: true, resources: true, civilization: true },
  civilization_features: []
}.to_json) %>
</script>

<%= javascript_include_tag 'player/planetary', "data-turbo-track": "reload" %>
