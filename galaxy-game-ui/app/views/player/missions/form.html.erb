<div class="mb-5"><p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Player / AI Manager / My Missions</p><h1 class="gg-section-title"><%= @mission[:id].present? ? "Edit mission guidance" : "Create a mission" %></h1><p class="text-sm" style="color:var(--gg-text-secondary);">Describe the outcome and operating constraints. Your AI Manager determines the task plan using shared capabilities; players do not edit the shared Task Library.</p></div>
<section class="gg-grid-panel space-y-4">
  <div><label class="block text-xs uppercase mb-1" style="color:var(--gg-text-dim);">Mission name</label><input value="<%= @mission[:name] %>" class="w-full rounded px-3 py-2 text-sm" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);" /></div>
  <div><label class="block text-xs uppercase mb-1" style="color:var(--gg-text-dim);">Objective / desired outcome</label><textarea rows="3" class="w-full rounded px-3 py-2 text-sm" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);"><%= @mission[:objective] %></textarea></div>
  <div><label class="block text-xs uppercase mb-1" style="color:var(--gg-text-dim);">Target settlement or operating scope</label><input value="<%= @mission[:target] %>" class="w-full rounded px-3 py-2 text-sm" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);" /></div>
  <div><label class="block text-xs uppercase mb-1" style="color:var(--gg-text-dim);">Guidance for your AI Manager</label><textarea rows="4" class="w-full rounded px-3 py-2 text-sm" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);"><%= @mission[:guidance] %></textarea></div>
  <div><label class="block text-xs uppercase mb-1" style="color:var(--gg-text-dim);">Constraints and priorities</label><textarea rows="3" class="w-full rounded px-3 py-2 text-sm" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);"><%= Array(@mission[:constraints]).join("\n") %></textarea></div>
  <div class="flex items-center justify-between gap-3"><span class="text-xs" style="color:var(--gg-text-dim);">Prototype only · edits are not saved and no assets are deployed.</span><%= link_to "Cancel", player_missions_path, class: "text-sm", style: "color:var(--gg-primary);" %></div>
</section>
