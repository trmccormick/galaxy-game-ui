<%= stylesheet_link_tag "pages/player_space", "data-turbo-track": "reload" %>

<section class="space-workspace" data-space-root data-workspace="<%= @fleet_manager ? "fleet_manager" : "space" %>">
  <header class="space-heading">
    <div>
      <div class="space-eyebrow">PLAYER OPERATIONS / SPACE</div>
      <h1><%= @fleet_manager ? "Fleet Manager" : "Space Operations" %></h1>
      <p><%= @fleet_manager ? "Coordinate fleet groupings and independently dispatched craft across systems." : "Track an individual spacecraft across the wormhole network and within its current star system." %></p>
    </div>
    <div class="space-heading-status"><span class="space-live-dot"></span> PROTOTYPE TELEMETRY <span class="space-fixture-tag">FIXTURE DATA</span></div>
  </header>

  <div class="space-toolbar">
    <label for="space-system-select">System focus</label>
    <select id="space-system-select">
      <% @systems.each do |system| %>
        <option value="<%= system["id"] %>" <%= "selected" if system["id"] == @selected_system["id"] %>><%= system["name"] %></option>
      <% end %>
    </select>
    <span class="space-toolbar-divider"></span>
    <span class="space-toolbar-meta"><%= @systems.length %> systems in test universe</span>
    <span class="space-toolbar-meta"><%= @universe.fetch("connections").length %> configured connection</span>
    <span class="space-toolbar-spacer"></span>
    <span class="space-toolbar-meta">Map data supplied by Rails</span>
  </div>

  <div class="space-main-grid">
    <aside class="space-craft-panel space-operations-panel">
      <div class="space-panel-heading">
        <div><span class="space-eyebrow"><%= @fleet_manager ? "OPERATIONAL GROUPS" : "ASSET CONTROL" %></span><h2><%= @fleet_manager ? "Operations" : "Craft" %></h2></div>
        <span class="space-count"><%= @fleet_manager ? @operations.length : @craft.length %></span>
      </div>

      <% if @fleet_manager %>
      <section class="space-operation-group">
        <div class="space-operation-group-heading">
          <span>FLEET OPERATIONS</span>
          <span class="space-group-count"><%= @operations.count { |operation| operation[:kind] == "fleet" } %></span>
        </div>
        <% @operations.select { |operation| operation[:kind] == "fleet" }.each do |operation| %>
          <div class="space-operation-card fleet-operation">
            <div class="space-operation-title"><span class="space-operation-symbol fleet-symbol">F</span><strong><%= operation[:name] %></strong><span class="space-operation-state"><%= operation[:status] %></span></div>
            <p><%= operation[:objective] %></p>
            <div class="space-operation-members">
              <% operation[:craft_ids].each do |craft_id| %>
                <% craft = @craft.find { |item| item[:id] == craft_id } %>
                <% next unless craft %>
                <button class="space-craft-item space-operation-craft <%= "is-selected" if craft[:id] == @selected_craft[:id] %>" type="button" data-craft-id="<%= craft[:id] %>">
                  <span class="space-craft-indicator <%= craft[:status] == "Operating" ? "is-operating" : "" %>"></span>
                  <span class="space-craft-copy"><strong><%= craft[:name] %></strong><small><%= craft[:role] %></small><small><%= craft[:location] %></small></span>
                  <span class="space-craft-chevron">›</span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>

      <section class="space-operation-group">
        <div class="space-operation-group-heading">
          <span>INDEPENDENT DISPATCHES</span>
          <span class="space-group-count"><%= @operations.count { |operation| operation[:kind] == "independent" } %></span>
        </div>
        <% @operations.select { |operation| operation[:kind] == "independent" }.each do |operation| %>
          <% craft = @craft.find { |item| item[:id] == operation[:craft_ids].first } %>
          <% next unless craft %>
          <button class="space-craft-item space-independent-item <%= "is-selected" if craft[:id] == @selected_craft[:id] %>" type="button" data-craft-id="<%= craft[:id] %>">
            <span class="space-craft-indicator <%= craft[:status] == "Operating" ? "is-operating" : "" %>"></span>
            <span class="space-craft-copy"><strong><%= operation[:name] %></strong><small><%= craft[:name] %> · <%= craft[:status] %></small><small><%= operation[:objective] %></small></span>
            <span class="space-craft-chevron">›</span>
          </button>
        <% end %>
      </section>
      <div class="space-panel-footnote">Fleets group craft around a shared objective. Independent robotic missions are dispatched and tracked directly; no one-craft fleet is required.</div>
      <% else %>
        <div class="space-craft-list" role="list">
          <% @craft.each do |craft| %>
            <button class="space-craft-item <%= "is-selected" if craft[:id] == @selected_craft[:id] %>" type="button" data-craft-id="<%= craft[:id] %>" role="listitem">
              <span class="space-craft-indicator <%= craft[:status] == "Operating" ? "is-operating" : "" %>"></span>
              <span class="space-craft-copy"><strong><%= craft[:name] %></strong><small><%= craft[:type] %></small><small><%= craft[:location] %></small></span>
              <span class="space-craft-chevron">›</span>
            </button>
          <% end %>
        </div>
        <div class="space-panel-footnote">Craft operate autonomously. Select one to inspect its current system, routes, and reported status.</div>
      <% end %>
    </aside>

    <div class="space-maps-column">
      <section class="space-map-panel galaxy-map-panel">
        <div class="space-map-heading">
          <div><span class="space-eyebrow">ASTRONOMICAL NEIGHBORHOOD</span><h2>Galaxy View · Sol</h2><p>Real nearby-system positions · sky boundaries shown separately from physical space</p></div>
          <div class="space-map-actions galaxy-mode-actions">
            <button type="button" data-galaxy-mode="spatial" aria-pressed="true">Spatial</button>
            <button type="button" data-galaxy-mode="sky" aria-pressed="false">Constellations</button>
            <button type="button" data-map-reset="galaxy-spatial">Reset</button>
          </div>
        </div>
        <div class="galaxy-map-stage" data-galaxy-canvas="spatial">
          <div class="galaxy-map-caption">PHYSICAL NEIGHBORHOOD · EQUATORIAL CARTESIAN PROJECTION · LIGHT-YEARS</div>
          <div class="space-map-canvas galaxy-spatial-canvas"><svg id="space-galaxy-map" role="img" aria-label="Three-dimensional spatial projection of Sol's nearby star systems"></svg></div>
          <div class="galaxy-map-footnote">Local Bubble is a physical interstellar region. Its boundary is intentionally not drawn here because this fixture does not include a sourced 3D boundary model. Real systems without a loaded local-system fixture remain catalog entries; Alpha Centauri can open its existing System View fixture.</div>
        </div>
        <div class="galaxy-map-stage" data-galaxy-canvas="sky" hidden>
          <div class="galaxy-map-caption">SOL OBSERVING SKY · RIGHT ASCENSION / DECLINATION · IAU BOUNDARIES</div>
          <div class="space-map-actions galaxy-sky-reset"><button type="button" data-map-reset="galaxy-sky">Reset sky view</button></div>
          <div class="space-map-canvas galaxy-sky-canvas"><svg id="space-constellation-map" role="img" aria-label="IAU constellation boundaries and nearby star systems as seen from Sol"></svg></div>
          <div class="galaxy-map-footnote">Constellations are angular sky regions, not 3D stellar neighborhoods. Positions are source-derived; the nearby-star source does not state its coordinate epoch, so boundary matches remain provisional.</div>
        </div>
        <div class="galaxy-selection-details">
          <strong id="galaxy-selection-name">Select a nearby system</strong>
          <span id="galaxy-selection-details">31 curated real-system seeds in this UI catalog</span>
        </div>
      </section>
      <section class="space-map-panel">
        <div class="space-map-heading">
          <div><span class="space-eyebrow">INTER-SYSTEM</span><h2>Wormhole Network</h2><p>Network topology · known systems and configured connections</p></div>
          <div class="space-map-actions"><button type="button" data-map-reset="network">Reset view</button></div>
        </div>
        <div class="space-map-canvas network-canvas" data-map="network">
          <svg id="space-network-map" role="img" aria-label="Wormhole network map"></svg>
          <div class="space-map-legend"><span><i class="legend-dot home"></i> Sol baseline</span><span><i class="legend-line natural"></i> Natural connection</span><span><i class="legend-dot unknown"></i> Not connected</span></div>
        </div>
      </section>

      <section class="space-map-panel">
        <div class="space-map-heading">
          <div><span class="space-eyebrow">IN-SYSTEM</span><h2 id="space-system-title"><%= @selected_system["name"] %></h2><p>Illustrative spatial layout · bodies, infrastructure, and craft locations</p></div>
          <div class="space-map-actions"><button type="button" data-map-reset="system">Reset view</button></div>
        </div>
        <div class="space-map-canvas system-canvas" data-map="system">
          <svg id="space-system-map" role="img" aria-label="Selected star system navigation map"></svg>
          <div class="space-map-legend"><span><i class="legend-dot star"></i> Star</span><span><i class="legend-dot body"></i> Celestial body</span><span><i class="legend-dot station"></i> Facility</span><span><i class="legend-dot craft"></i> Craft</span></div>
        </div>
      </section>
    </div>

    <aside class="space-inspector">
      <section class="space-inspector-card">
        <div class="space-panel-heading"><div><span class="space-eyebrow">SELECTED ASSET</span><h2 id="space-inspector-name"><%= @selected_craft[:name] %></h2></div><span class="space-status-pill" id="space-inspector-status"><%= @selected_craft[:status] %></span></div>
        <dl class="space-details">
          <div><dt>Class</dt><dd id="space-inspector-type"><%= @selected_craft[:type] %></dd></div>
          <div><dt>Current location</dt><dd id="space-inspector-location"><%= @selected_craft[:location] %></dd></div>
          <div><dt>Destination</dt><dd id="space-inspector-destination"><%= @selected_craft[:destination] %></dd></div>
          <div><dt>Assignment</dt><dd id="space-inspector-operation"><%= @selected_craft[:assignment_type] %> · <%= @selected_craft[:operation] %></dd></div>
          <div><dt>Telemetry</dt><dd id="space-inspector-updated"><%= @selected_craft[:updated] %></dd></div>
        </dl>
        <div class="space-progress-label"><span>Mission progress</span><strong id="space-inspector-progress"><%= @selected_craft[:progress] %>%</strong></div>
        <div class="space-progress-track"><span id="space-progress-fill" style="width:<%= @selected_craft[:progress] %>%"></span></div>
        <div class="space-route-block"><h3>Ordered route</h3><ol id="space-route-list"><% @selected_craft[:route].each do |system_id| %><li><%= @systems.find { |system| system["id"] == system_id }&.fetch("name", system_id) || system_id %></li><% end %></ol></div>
        <div class="space-route-block"><h3>In-system itinerary</h3><ol id="space-local-route-list"><% (@selected_craft[:local_route] || []).each do |location_id| %><li><%= location_id.tr("-", " ").titleize %></li><% end %></ol></div>
      </section>
      <section class="space-inspector-card space-system-card">
        <span class="space-eyebrow">SYSTEM CONTEXT</span>
        <h2 id="space-system-inspector-name"><%= @system_data["name"] %></h2>
        <div class="space-system-stats"><span><strong id="space-body-count"><%= @system_data.fetch("bodies", []).length %></strong><small>Bodies</small></span><span><strong id="space-station-count"><%= @system_data.fetch("stations", []).length %></strong><small>Facilities</small></span></div>
        <p id="space-system-note"><%= @system_data["note"] %></p>
      </section>
    </aside>
  </div>

  <script type="application/json" id="space-view-data"><%= raw(json_escape({ universe: @universe, galaxy_catalog: @galaxy_catalog, constellation_catalog: @constellation_catalog, system: @system_data, craft: @craft, operations: @operations, selected_craft_id: @selected_craft[:id], selected_system_id: @selected_system["id"] }.to_json)) %></script>
</section>

<%= javascript_import_module_tag "player/space" %>