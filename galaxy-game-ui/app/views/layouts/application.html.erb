<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Galaxy Game" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Galaxy Game">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Explicitly point to the PNG in public/ -->
    <link rel="icon" href="/icon.png" type="image/png">
    <!-- Optional: for Apple touch devices -->
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-[var(--bg)] text-[var(--text)]">
    <!-- Galaxy Game topbar -->
    <header class="border-b border-[var(--line)]">
      <div class="mx-auto max-w-5xl px-4 py-3 flex items-center justify-between gap-4">
        <a href="<%= root_path %>" class="text-lg font-semibold" style="color: var(--gold);">Galaxy Game</a>
        <nav class="flex items-center gap-3 text-sm">
          <% if authenticated? %>
            <%= link_to "Dashboard", dashboard_path,
                  class: "rounded px-3 py-1.5 hover:bg-[var(--panel2)] transition-colors" %>
            <span class="hidden sm:inline" style="color: var(--muted);"><%= Current.user&.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "rounded px-3 py-1.5 bg-[var(--panel2)] hover:bg-[var(--line)] transition-colors" %>
          <% else %>
            <%= link_to "Sign in", new_session_path,
                  class: "rounded px-3 py-1.5 border border-[var(--line)] hover:border-[var(--accent)] transition-colors" %>
          <% end %>
        </nav>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <div class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
        <!-- Flash messages -->
        <% if notice.present? %>
          <div class="mb-5 rounded border-l-4" style="border-color: var(--accent); background-color: var(--panel); color: var(--text); padding: 1rem;">
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="mb-5 rounded border-l-4" style="border-color: var(--red); background-color: var(--panel); color: var(--text); padding: 1rem;">
            <%= alert %>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--line)] py-4 text-center text-sm" style="color: var(--muted);">
      Galaxy Game UI prototype
    </footer>
  </body>
</html>
