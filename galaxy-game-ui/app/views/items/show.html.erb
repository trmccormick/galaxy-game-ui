<div class="item-detail">
  <div class="detail-header">
    <div class="detail-image">
      <% if @item[:image_path].present? %>
        <%= image_tag @item[:image_path], alt: @item[:name] %>
      <% else %>
        <div class="placeholder large"><%= @item[:material_type].titleize %></div>
      <% end %>
    </div>
    
    <div class="detail-info">
      <h1><%= @item[:name] %></h1>
      <p class="detail-description"><%= @item[:description] %></p>
      
      <div class="detail-badges">
        <span class="badge type"><%= @item[:material_type].titleize %></span>
        <span class="badge rarity <%= @item[:rarity] %>"><%= @item[:rarity].titleize %></span>
        <span class="badge"><strong><%= @item[:unit_weight] %></strong> kg</span>
      </div>
      
      <div class="detail-properties">
        <h3>Properties</h3>
        <dl>
          <dt>Source:</dt>
          <dd><%= @item[:source] %></dd>
          <dt>Unit Weight:</dt>
          <dd><%= @item[:unit_weight] %> kg</dd>
          <dt>Durability:</dt>
          <dd><%= @item[:durability] %></dd>
          <dt>Rarity:</dt>
          <dd><%= @item[:rarity].titleize %></dd>
        </dl>
      </div>
      
      <% if @item[:tags].present? %>
        <div class="detail-tags">
          <h3>Tags</h3>
          <div class="tags-list">
            <% @item[:tags].each do |tag| %>
              <span class="tag"><%= tag.titleize %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="blueprints-using">
    <h2>Used In Blueprints</h2>
    <% if @blueprints_using_item.any? %>
      <ul class="blueprint-links">
        <% @blueprints_using_item.each do |bp| %>
          <li><%= link_to bp[:name], blueprint_path(bp[:id]) %></li>
        <% end %>
      </ul>
    <% else %>
      <p>This item is not used in any known blueprints</p>
    <% end %>
  </div>
  
  <%= link_to "← Back to Items", items_path, class: "btn btn-secondary" %>
</div>
