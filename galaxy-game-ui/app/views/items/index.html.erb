<div class="items-container">
  <div class="topbar-items">
    <h1>Item Catalog</h1>
    
    <div class="search-filter">
      <%= form_with url: items_path, method: :get, local: true do |f| %>
        <%= f.text_field :search, placeholder: "Search items...", value: params[:search], class: "search-input" %>
        
        <%= f.select :type, 
            options_for_select([
              ["All Types", ""],
              ["Manufactured Goods", "manufactured_goods"],
              ["Metals", "metal"],
              ["Components", "component"],
              ["Processed Materials", "processed_material"],
              ["Gases", "gas"],
              ["Consumables", "consumable"],
              ["Liquids", "liquid"],
              ["Fuels", "fuel"],
              ["Raw Materials", "raw_material"]
            ], params[:type]),
            { include_blank: false, class: "filter-select" } %>
        
        <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>
  
  <div class="items-grid">
    <% if @items.any? %>
      <% @items.each do |item| %>
        <div class="item-card" onclick="window.location='<%= item_path(item[:name]) %>'">
          <div class="card-image">
            <% if item[:image_path].present? %>
              <%= image_tag item[:image_path], alt: item[:name] %>
            <% else %>
              <div class="placeholder"><%= item[:material_type].titleize %></div>
            <% end %>
          </div>
          
          <div class="card-body">
            <h3><%= link_to item[:name], item_path(item[:name]), class: "item-name-link" %></h3>
            <p class="card-description"><%= truncate(item[:description], length: 80) %></p>
            
            <div class="card-badges">
              <span class="badge type"><%= item[:material_type].titleize %></span>
              <span class="badge rarity <%= item[:rarity] %>"><%= item[:rarity].titleize %></span>
            </div>
            
            <div class="card-amount">
              In Stock: <%= number_with_delimiter(item[:amount]) %> units
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="no-results">No items found matching your criteria.</p>
    <% end %>
  </div>
</div>
