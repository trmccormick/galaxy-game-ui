<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Admin / AI Manager</p>
    <h1 class="gg-section-title">Decision Log</h1>
    <p class="text-sm" style="color:var(--gg-text-secondary);">Decision rationale, source, authority, and linked operational task</p>
  </div>
  <span class="text-xs px-3 py-1 rounded" style="background:rgba(255,214,10,.12);color:var(--gg-accent-warning);">Illustrative decision records · not live</span>
</div>

<div class="gg-grid-panel mb-5">
  <div class="flex flex-wrap justify-between items-end gap-3">
    <div>
      <h2 class="gg-section-title text-lg">System context</h2>
      <p class="text-xs" style="color:var(--gg-text-dim);">Choose the fixture context whose decision records you want to inspect.</p>
    </div>
    <%= form_with url: admin_ai_manager_decisions_path, method: :get, local: true, class: "flex flex-wrap items-end gap-2" do %>
      <div>
        <%= label_tag :system, "System", class: "block text-xs mb-1", style: "color:var(--gg-text-dim);" %>
        <%= select_tag :system, options_for_select(@systems.map { |system| [system[:name], system[:id]] }, @selected_system), class: "rounded px-3 py-2 text-sm", style: "background:var(--gg-bg-base);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);" %>
      </div>
      <%= submit_tag "Load context", class: "px-4 py-2 rounded text-sm font-semibold", style: "background:rgba(0,212,255,.14);color:var(--gg-primary);border:1px solid rgba(0,212,255,.3);" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5">
  <% [
    ["Sample records", @decision_counts[:total]],
    ["Needs review", @decision_counts[:awaiting_review]],
    ["Active", @decision_counts[:active]],
    ["Blocked", @decision_counts[:blocked]]
  ].each do |label, value| %>
    <div class="gg-grid-panel text-center">
      <div class="gg-metric"><%= value %></div>
      <div class="gg-stat-label mt-1"><%= label %></div>
    </div>
  <% end %>
</div>

<section class="gg-grid-panel mb-5 overflow-x-auto">
  <h2 class="gg-section-title text-lg">Decision records</h2>
  <table class="w-full text-sm mt-3">
    <thead>
      <tr class="text-left text-xs uppercase" style="color:var(--gg-text-dim);">
        <th class="py-2 pr-3">Decision</th>
        <th class="py-2 pr-3">Target</th>
        <th class="py-2 pr-3">Type</th>
        <th class="py-2 pr-3">Source / authority</th>
        <th class="py-2 pr-3">Outcome</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @decisions.each do |decision| %>
        <tr class="border-t align-top" style="border-color:rgba(0,212,255,.1);">
          <td class="py-3 pr-3">
            <div class="font-semibold"><%= decision[:title] %></div>
            <div class="text-xs mt-1" style="color:var(--gg-text-secondary);"><%= decision[:reasoning] %></div>
            <div class="text-xs font-mono mt-1" style="color:var(--gg-text-dim);"><%= decision[:id] %> · <%= decision[:recorded_label] %></div>
          </td>
          <td class="py-3 pr-3"><%= decision[:target] %></td>
          <td class="py-3 pr-3"><%= decision[:decision_type] %></td>
          <td class="py-3 pr-3">
            <div><%= decision[:source] %></div>
            <div class="text-xs mt-1" style="color:var(--gg-text-dim);"><%= decision[:authority] %></div>
          </td>
          <td class="py-3 pr-3"><%= decision[:outcome] %></td>
          <td class="py-3 text-right whitespace-nowrap"><%= link_to "Open task →", admin_ai_manager_workbench_task_path(decision[:task_id]), class: "text-xs font-semibold", style: "color:var(--gg-primary);" %></td>
        </tr>
      <% end %>
      <% if @decisions.empty? %>
        <tr><td colspan="6" class="py-6 text-center text-sm" style="color:var(--gg-text-dim);">No sample decision records exist for this system context.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<div class="flex flex-wrap gap-3">
  <%= link_to "← Operations overview", admin_ai_manager_path(system: @selected_system), class: "text-sm", style: "color:var(--gg-primary);" %>
  <%= link_to "Open task workbench →", admin_ai_manager_workbench_path(system: @selected_system), class: "text-sm", style: "color:var(--gg-primary);" %>
</div>
