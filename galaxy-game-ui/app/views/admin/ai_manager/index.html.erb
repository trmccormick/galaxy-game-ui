<h1 class="gg-section-title">AI Manager — Dashboard</h1>

<!-- System Status Banner -->
<div class="gg-grid-panel mb-6 flex items-center justify-between" style="border-left: 3px solid var(--gg-accent-success);">
  <div>
    <span class="text-sm text-[var(--gg-text-secondary)] uppercase tracking-wider">System Status</span>
    <h2 class="text-xl font-bold mt-1" style="color: var(--gg-primary);">OPERATIONAL</h2>
    <p class="text-xs text-[var(--gg-text-dim)] mt-1">All AI subsystems active • Version 1.0.0-alpha</p>
  </div>
  <div class="text-right">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold" style="background: rgba(6,255,165,0.1); color: var(--gg-accent-success);">
      <span class="w-2 h-2 rounded-full" style="background: var(--gg-accent-success); animation: pulse 2s infinite;"></span>
      All Systems Nominal
    </span>
  </div>
</div>

<!-- KPI Row -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="gg-grid-panel text-center">
    <div class="gg-metric"><%= @system_status[:active_missions] %></div>
    <div class="gg-stat-label mt-1">Active Missions</div>
  </div>
  <div class="gg-grid-panel text-center">
    <div class="gg-metric" style="color: var(--gg-accent-success);"><%= @system_status[:completed_missions] %></div>
    <div class="gg-stat-label mt-1">Completed Missions</div>
  </div>
  <div class="gg-grid-panel text-center">
    <div class="gg-metric" style="color: var(--gg-accent-danger);"><%= @system_status[:failed_missions] %></div>
    <div class="gg-stat-label mt-1">Failed Missions</div>
  </div>
  <div class="gg-grid-panel text-center">
    <div class="gg-metric" style="color: var(--gg-accent-warning);"><%= @system_status[:total_settlements] %></div>
    <div class="gg-stat-label mt-1">Settlements</div>
  </div>
</div>

<!-- Quick Actions -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <div class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Quick Actions</h2>
    <div class="space-y-3">
      <% @quick_actions.each do |action| %>
        <div class="flex items-start justify-between py-3 border-b border-[rgba(0,212,255,0.1)] last:border-b-0">
          <div>
            <div class="font-semibold text-sm" style="color: var(--gg-primary);"><%= action[:title] %></div>
            <div class="text-xs mt-1" style="color: var(--gg-text-secondary);"><%= action[:description] %></div>
          </div>
          <% if action[:path] != '#' %>
            <%= link_to 'Go →', action[:path], class: 'text-xs px-3 py-1 rounded transition-colors', style: 'background: rgba(0,212,255,0.1); color: var(--gg-primary);' %>
          <% else %>
            <span class="text-xs px-3 py-1 rounded" style="background: rgba(0,212,255,0.05); color: var(--gg-text-dim);">Prototype</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Recent Mission Activity</h2>
    <div class="space-y-3">
      <% if @active_missions.any? %>
        <% @active_missions.first(5).each do |mission| %>
          <div class="flex items-center justify-between py-2 border-b border-[rgba(0,212,255,0.05)] last:border-b-0">
            <div>
              <div class="font-mono text-sm font-semibold" style="color: var(--gg-primary);"><%= mission[:identifier] %></div>
              <div class="text-xs mt-0.5" style="color: var(--gg-text-secondary);">
                <%= mission[:settlement] %> • <%= mission[:type].to_s.humanize %>
              </div>
            </div>
            <div class="text-right">
              <span class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background: rgba(0,212,255,0.1); color: var(--gg-primary);">
                <%= mission[:progress] %>%
              </span>
              <div class="text-[10px] mt-1" style="color: var(--gg-text-dim);"><%= time_ago_in_words(mission[:created_at]) %> ago</div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-8">
          <div class="text-3xl mb-2">📋</div>
          <div class="text-sm" style="color: var(--gg-text-secondary);">No active missions</div>
          <div class="text-xs mt-1" style="color: var(--gg-text-dim);">Start a new mission to see activity here</div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Settlement Overview -->
<div class="gg-grid-panel">
  <h2 class="gg-section-title text-lg">Settlement Network</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-[rgba(0,212,255,0.15)]">
          <th class="text-left py-2 px-3 text-xs uppercase tracking-wider" style="color: var(--gg-text-secondary);">Settlement</th>
          <th class="text-center py-2 px-3 text-xs uppercase tracking-wider" style="color: var(--gg-text-secondary);">Status</th>
          <th class="text-center py-2 px-3 text-xs uppercase tracking-wider" style="color: var(--gg-text-secondary);">Population</th>
          <th class="text-center py-2 px-3 text-xs uppercase tracking-wider" style="color: var(--gg-text-secondary);">Systems</th>
        </tr>
      </thead>
      <tbody>
        <% @settlements.each do |settlement| %>
          <tr class="border-b border-[rgba(0,212,255,0.05)] hover:bg-[rgba(0,212,255,0.03)] transition-colors">
            <td class="py-2 px-3 font-medium" style="color: var(--gg-text-primary);"><%= settlement[:name] %></td>
            <td class="py-2 px-3 text-center">
              <span class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background: <%= case settlement[:status]
                when 'operational' then 'rgba(6,255,165,0.15)'
                when 'expanding' then 'rgba(0,212,255,0.15)'
                when 'maintenance' then 'rgba(255,214,10,0.15)'
                when 'under_construction' then 'rgba(157,78,221,0.15)'
                when 'planning' then 'rgba(136,146,176,0.15)'
                else 'rgba(136,146,176,0.15)'
              end %>; color: <%= case settlement[:status]
                when 'operational' then 'var(--gg-accent-success)'
                when 'expanding' then 'var(--gg-primary)'
                when 'maintenance' then 'var(--gg-accent-warning)'
                when 'under_construction' then 'var(--gg-accent-purple)'
                when 'planning' then 'var(--gg-text-secondary)'
                else 'var(--gg-text-secondary)'
              end %>;">
                <%= settlement[:status].to_s.humanize %>
              </span>
            </td>
            <td class="py-2 px-3 text-center" style="color: var(--gg-text-primary);"><%= settlement[:population] %></td>
            <td class="py-2 px-3 text-center" style="color: var(--gg-text-primary);"><%= settlement[:systems_count] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-6 text-center">
  <%= link_to '← Back to Admin Dashboard', admin_dashboard_path, class: 'inline-block px-4 py-2 rounded transition-colors text-sm', style: 'background: rgba(0,212,255,0.08); color: var(--gg-text-secondary); border: 1px solid rgba(0,212,255,0.2);' %>
</div>

<style>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
</style>
