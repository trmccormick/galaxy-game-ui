<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Admin / AI Manager</p>
    <h1 class="gg-section-title">Operations Overview</h1>
    <p class="text-sm" style="color:var(--gg-text-secondary);">Shared AI Manager capabilities · Admin oversight of NPC operations</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-xs px-3 py-1 rounded" style="background:rgba(255,214,10,.12);color:var(--gg-accent-warning);"><%= @overview[:source_label] %></span>
    <%= link_to "Mission monitor & run history →", admin_ai_manager_missions_path, class: "text-xs font-semibold px-3 py-2 rounded", style: "background:rgba(0,212,255,.10);color:var(--gg-primary);border:1px solid rgba(0,212,255,.24);" %>
  </div>
</div>

<section class="gg-grid-panel mb-5">
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-4 items-end">
    <div>
      <h2 class="gg-section-title text-lg">System context</h2>
      <p class="text-sm font-semibold" style="color:var(--gg-primary);"><%= @overview[:system][:name] %></p>
      <p class="text-xs mt-1" style="color:var(--gg-text-secondary);"><%= @overview[:system][:description] %></p>
      <p class="text-sm mt-3"><%= @overview[:system][:focus] %></p>
      <div class="flex flex-wrap gap-2 mt-3 text-xs">
        <span class="px-2 py-1 rounded" style="background:rgba(0,212,255,.08);color:var(--gg-text-secondary);">Scope: <%= @overview[:system][:scope] %></span>
        <span class="px-2 py-1 rounded" style="background:rgba(0,212,255,.08);color:var(--gg-text-secondary);">Authority: Admin oversight</span>
        <span class="px-2 py-1 rounded" style="background:rgba(0,212,255,.08);color:var(--gg-text-secondary);">Data: illustrative fixtures</span>
      </div>
    </div>
    <%= form_with url: admin_ai_manager_path, method: :get, local: true, class: "flex flex-wrap items-end gap-2" do %>
      <div>
        <%= label_tag :system, "Change system", class: "block text-xs mb-1", style: "color:var(--gg-text-dim);" %>
        <%= select_tag :system, options_for_select(@systems.map { |system| [system[:name], system[:id]] }, @selected_system), class: "rounded px-3 py-2 text-sm", style: "background:var(--gg-bg-base);border:1px solid rgba(0,212,255,.2);color:var(--gg-text-primary);" %>
      </div>
      <%= submit_tag "Load context", class: "px-4 py-2 rounded text-sm font-semibold", style: "background:rgba(0,212,255,.14);color:var(--gg-primary);border:1px solid rgba(0,212,255,.3);" %>
    <% end %>
  </div>
</section>

<div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 mb-5">
  <% [
    ["Needs attention", @overview[:counts][:attention]],
    ["Queued", @overview[:counts][:queued]],
    ["Active", @overview[:counts][:active]],
    ["Blocked", @overview[:counts][:blocked]],
    ["Completed", @overview[:counts][:completed]]
  ].each do |label, value| %>
    <div class="gg-grid-panel">
      <div class="gg-metric"><%= value %></div>
      <div class="gg-stat-label"><%= label %></div>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-5">
  <section class="gg-grid-panel">
    <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
      <div>
        <h2 class="gg-section-title text-lg mb-0">Current objectives</h2>
        <p class="text-xs mt-1" style="color:var(--gg-text-dim);">Active and pending operational work in this context</p>
      </div>
      <%= link_to "Open workbench →", admin_ai_manager_workbench_path(system: @selected_system), class: "text-xs font-semibold", style: "color:var(--gg-primary);" %>
    </div>
    <div class="space-y-3">
      <% @overview[:objectives].each do |task| %>
        <article class="rounded p-3" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.12);">
          <div class="flex flex-wrap justify-between gap-2">
            <h3 class="text-sm font-semibold"><%= task[:title] %></h3>
            <span class="text-xs" style="color:var(--gg-accent-warning);"><%= task[:status_label] %></span>
          </div>
          <p class="text-xs mt-2" style="color:var(--gg-text-secondary);"><%= task[:objective] %></p>
          <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs" style="color:var(--gg-text-dim);">
            <span>Target: <%= task[:target] %></span>
            <span>Priority: <%= task[:priority].humanize %></span>
            <span>Origin: <%= task[:origin] %></span>
          </div>
          <div class="mt-3">
            <%= link_to "Inspect task →", admin_ai_manager_workbench_task_path(task[:id]), class: "text-xs font-semibold", style: "color:var(--gg-primary);" %>
          </div>
        </article>
      <% end %>
      <% if @overview[:objectives].empty? %>
        <p class="text-sm py-4" style="color:var(--gg-text-dim);">No open objectives in this fixture context.</p>
      <% end %>
    </div>
  </section>

  <section class="gg-grid-panel">
    <div class="mb-3">
      <h2 class="gg-section-title text-lg mb-0">Current operating conditions</h2>
      <p class="text-xs mt-1" style="color:var(--gg-text-dim);">Conditions requiring review or preventing work from proceeding</p>
    </div>
    <div class="space-y-3">
      <% @overview[:conditions].each do |condition| %>
        <article class="rounded p-3" style="background:var(--gg-bg-surface);border-left:3px solid <%= condition[:status] == 'blocked' ? 'var(--gg-accent-danger)' : 'var(--gg-accent-warning)' %>;">
          <div class="flex flex-wrap justify-between gap-2">
            <h3 class="text-sm font-semibold"><%= condition[:target] %></h3>
            <span class="text-xs" style="color:var(--gg-text-dim);"><%= condition[:status_label] %></span>
          </div>
          <p class="text-sm mt-2"><%= condition[:rationale] %></p>
          <p class="text-xs mt-2" style="color:var(--gg-text-dim);"><%= condition[:title] %> · <%= condition[:priority].humanize %> priority</p>
          <%= link_to "Open related task →", admin_ai_manager_workbench_task_path(condition[:id]), class: "inline-block mt-2 text-xs font-semibold", style: "color:var(--gg-primary);" %>
        </article>
      <% end %>
      <% if @overview[:conditions].empty? %>
        <p class="text-sm py-4" style="color:var(--gg-text-dim);">No conditions require attention in this fixture context.</p>
      <% end %>
    </div>
  </section>
</div>

<section class="gg-grid-panel mb-5">
  <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
    <div>
      <h2 class="gg-section-title text-lg mb-0">Recent decision activity</h2>
      <p class="text-xs mt-1" style="color:var(--gg-text-dim);">Illustrative records linked to the operational task context</p>
    </div>
    <%= link_to "Decision log →", admin_ai_manager_decisions_path(system: @selected_system), class: "text-xs font-semibold", style: "color:var(--gg-primary);" %>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
    <% @overview[:recent_decisions].each do |decision| %>
      <article class="rounded p-3" style="background:var(--gg-bg-surface);border:1px solid rgba(0,212,255,.12);">
        <div class="flex flex-wrap justify-between gap-2">
          <h3 class="text-sm font-semibold"><%= decision[:title] %></h3>
          <span class="text-xs" style="color:var(--gg-accent-warning);"><%= decision[:outcome] %></span>
        </div>
        <p class="text-xs mt-2" style="color:var(--gg-text-secondary);"><%= decision[:reasoning] %></p>
        <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-xs" style="color:var(--gg-text-dim);">
          <span><%= decision[:decision_type] %></span>
          <span>Source: <%= decision[:source] %></span>
          <span>Authority: <%= decision[:authority] %></span>
          <span><%= decision[:recorded_label] %></span>
        </div>
        <%= link_to "Open related task →", admin_ai_manager_workbench_task_path(decision[:task_id]), class: "inline-block mt-3 text-xs font-semibold", style: "color:var(--gg-primary);" %>
      </article>
    <% end %>
    <% if @overview[:recent_decisions].empty? %>
      <p class="text-sm py-4" style="color:var(--gg-text-dim);">No decision examples are available for this fixture context.</p>
    <% end %>
  </div>
</section>

<section class="gg-grid-panel">
  <h2 class="gg-section-title text-lg">Admin workspaces</h2>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Task Workbench", admin_ai_manager_workbench_path(system: @selected_system), class: "px-3 py-2 rounded text-sm", style: "background:rgba(0,212,255,.12);color:var(--gg-primary);border:1px solid rgba(0,212,255,.25);" %>
    <%= link_to "Shared Task Library", admin_ai_manager_library_tasks_path, class: "px-3 py-2 rounded text-sm", style: "border:1px solid rgba(0,212,255,.2);color:var(--gg-text-secondary);" %>
    <%= link_to "Mission Template Library", admin_ai_manager_library_missions_path, class: "px-3 py-2 rounded text-sm", style: "border:1px solid rgba(0,212,255,.2);color:var(--gg-text-secondary);" %>
  </div>
  <p class="text-xs mt-3" style="color:var(--gg-text-dim);">The Player-facing AI Manager will reuse these capabilities with a narrower player-owned asset scope and delegated authority. It is not part of this Admin workspace.</p>
</section>
