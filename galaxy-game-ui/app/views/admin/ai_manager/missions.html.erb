<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Admin / AI Manager / Operations</p>
    <h1 class="gg-section-title">Mission Monitor</h1>
    <p class="text-sm mt-1" style="color:var(--gg-text-secondary);">Current mission state, exceptions, and completed-run history.</p>
  </div>
  <span class="text-xs px-3 py-1 rounded" style="background:rgba(255,214,10,.10);color:var(--gg-accent-warning);">Illustrative prototype data · not live telemetry</span>
</div>

<div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 mb-5">
  <% [
    ["Active", @active_missions.length, "var(--gg-primary)"],
    ["Pending", @pending_missions.length, "var(--gg-text-secondary)"],
    ["Blocked", @blocked_missions.length, "var(--gg-accent-warning)"],
    ["Completed", @completed_missions.length, "var(--gg-accent-success)"],
    ["Failed / Stalled", @failed_missions.length, "var(--gg-accent-danger)"]
  ].each do |label, count, color| %>
    <div class="gg-grid-panel">
      <div class="gg-metric" style="color:<%= color %>;"><%= count %></div>
      <div class="gg-stat-label mt-1"><%= label %></div>
    </div>
  <% end %>
</div>

<section class="gg-grid-panel mb-5">
  <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
    <div>
      <h2 class="gg-section-title text-lg mb-0">Active operations</h2>
      <p class="text-xs mt-1" style="color:var(--gg-text-dim);">Independent missions progress concurrently; blocked work identifies its current constraint.</p>
    </div>
    <%= link_to "Operations overview →", admin_ai_manager_path, class: "text-xs font-semibold", style: "color:var(--gg-primary);" %>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs uppercase" style="color:var(--gg-text-dim);">
          <th class="py-2 pr-3">Mission</th><th class="py-2 pr-3">Location</th><th class="py-2 pr-3">Status</th><th class="py-2 pr-3">Progress</th><th class="py-2 pr-3">Created</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% (@active_missions + @pending_missions + @blocked_missions).each do |mission| %>
          <% status_color = mission[:status] == "blocked" ? "var(--gg-accent-warning)" : mission[:status] == "pending" ? "var(--gg-text-dim)" : "var(--gg-primary)" %>
          <tr class="border-t align-middle" style="border-color:rgba(0,212,255,.10);">
            <td class="py-3 pr-3 font-mono font-semibold"><%= mission[:identifier] %></td>
            <td class="py-3 pr-3"><%= mission[:settlement] %></td>
            <td class="py-3 pr-3"><span class="text-xs font-semibold" style="color:<%= status_color %>;"><%= mission[:status].to_s.humanize %></span><% if mission[:reason].present? %><div class="text-xs mt-1" style="color:var(--gg-text-dim);"><%= mission[:reason].to_s.humanize %></div><% end %></td>
            <td class="py-3 pr-3 min-w-28">
              <div class="text-xs mb-1" style="color:var(--gg-text-secondary);"><%= mission[:progress] || 0 %>%</div>
              <div class="h-1.5 rounded" style="background:rgba(0,212,255,.10);"><div class="h-1.5 rounded" style="width:<%= mission[:progress] || 0 %>%;background:<%= status_color %>;"></div></div>
            </td>
            <td class="py-3 pr-3 text-xs" style="color:var(--gg-text-dim);"><%= mission[:created_at].strftime("%Y-%m-%d") %></td>
            <td class="py-3 text-right"><%= link_to "Inspect →", admin_ai_manager_show_mission_path(identifier: mission[:identifier]), class: "text-xs font-semibold whitespace-nowrap", style: "color:var(--gg-primary);" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="gg-grid-panel mb-5">
  <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
    <div>
      <h2 class="gg-section-title text-lg mb-0">Completed missions</h2>
      <p class="text-xs mt-1" style="color:var(--gg-text-dim);">Open a completed run to inspect its task history and resulting world state.</p>
    </div>
    <span class="text-xs" style="color:var(--gg-accent-success);">Historical runs</span>
  </div>
  <div class="divide-y" style="border-color:rgba(0,212,255,.10);">
    <% @completed_missions.each do |mission| %>
      <div class="flex flex-wrap items-center justify-between gap-3 py-3">
        <div>
          <div class="font-mono text-sm font-semibold" style="color:var(--gg-accent-success);"><%= mission[:identifier] %></div>
          <div class="text-xs mt-1" style="color:var(--gg-text-secondary);"><%= mission[:settlement] %> · <%= mission[:type].to_s.humanize %></div>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs" style="color:var(--gg-text-dim);"><%= mission[:completion_date].strftime("%Y-%m-%d") %></span>
          <%= link_to "Review run →", admin_ai_manager_show_mission_path(identifier: mission[:identifier]), class: "text-xs font-semibold", style: "color:var(--gg-primary);" %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<% if @failed_missions.any? %>
  <section class="gg-grid-panel mb-5" style="border-left:3px solid var(--gg-accent-danger);">
    <h2 class="gg-section-title text-lg">Failed / stalled missions</h2>
    <div class="space-y-2 mt-3">
      <% @failed_missions.each do |mission| %>
        <div class="flex flex-wrap justify-between gap-2 p-3 rounded" style="background:rgba(255,0,110,.05);">
          <div><span class="font-mono text-sm font-semibold"><%= mission[:identifier] %></span><span class="text-xs ml-3" style="color:var(--gg-text-secondary);"><%= mission[:settlement] %></span></div>
          <span class="text-xs" style="color:var(--gg-accent-danger);"><%= mission[:reason].to_s.humanize %></span>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<div class="flex flex-wrap gap-3">
  <%= link_to "Decision log →", admin_ai_manager_decisions_path, class: "text-sm", style: "color:var(--gg-primary);" %>
  <%= link_to "Task workbench →", admin_ai_manager_workbench_path, class: "text-sm", style: "color:var(--gg-primary);" %>
  <%= link_to "Mission templates →", admin_ai_manager_library_missions_path, class: "text-sm", style: "color:var(--gg-primary);" %>
</div>
