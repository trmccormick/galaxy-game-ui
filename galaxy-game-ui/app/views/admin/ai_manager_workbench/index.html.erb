<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Admin / AI Manager</p>
    <h1 class="gg-section-title">Operations Workbench</h1>
    <p class="text-sm" style="color:var(--gg-text-secondary);">Shared autonomous-management capabilities · NPC operations</p>
  </div>
  <span class="text-xs px-3 py-1 rounded" style="background:rgba(255,214,10,.12);color:var(--gg-accent-warning);">Prototype fixtures · not connected to simulation</span>
</div>

<div class="flex flex-wrap gap-2 mb-5">
  <% @systems.each do |system| %>
    <%= link_to system[:name], admin_ai_manager_workbench_path(system: system[:id]),
      class: "px-4 py-2 rounded text-sm border",
      style: "border-color:#{@selected_system == system[:id] ? 'var(--gg-primary)' : 'rgba(0,212,255,.2)'};background:#{@selected_system == system[:id] ? 'rgba(0,212,255,.12)' : 'var(--gg-bg-panel)'};color:var(--gg-text-primary);" %>
  <% end %>
</div>

<div class="grid grid-cols-3 gap-3 mb-5">
  <% { "Needs attention" => @counts[:attention], "Active" => @counts[:active], "Completed" => @counts[:completed] }.each do |label, value| %>
    <div class="gg-grid-panel"><div class="gg-metric"><%= value %></div><div class="gg-stat-label"><%= label %></div></div>
  <% end %>
</div>

<div class="gg-grid-panel mb-5">
  <div class="flex justify-between items-center gap-3 mb-3">
    <h2 class="gg-section-title text-lg mb-0">Task queue · <%= @systems.find { |s| s[:id] == @selected_system }[:name] %></h2>
    <span class="text-xs" style="color:var(--gg-text-dim);"><%= @tasks.length %> illustrative tasks</span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-xs uppercase" style="color:var(--gg-text-dim);">
        <th class="py-2 pr-3">Task</th><th class="py-2 pr-3">Target</th><th class="py-2 pr-3">Origin</th><th class="py-2 pr-3">Priority</th><th class="py-2 pr-3">Status</th><th></th>
      </tr></thead>
      <tbody>
        <% @tasks.each do |task| %>
          <tr class="border-t" style="border-color:rgba(0,212,255,.1);">
            <td class="py-3 pr-3"><div class="font-semibold" style="color:var(--gg-text-primary);"><%= task[:title] %></div><div class="text-xs font-mono" style="color:var(--gg-text-dim);"><%= task[:id] %></div></td>
            <td class="py-3 pr-3"><%= task[:target] %><div class="text-xs" style="color:var(--gg-text-dim);"><%= task[:target_type] %></div></td>
            <td class="py-3 pr-3"><%= task[:origin] %></td><td class="py-3 pr-3"><%= task[:priority].humanize %></td>
            <td class="py-3 pr-3"><%= task[:status].humanize %></td>
            <td class="py-3 text-right whitespace-nowrap"><%= link_to "Open →", admin_ai_manager_workbench_task_path(task[:id]), class: "text-xs font-semibold", style: "color:var(--gg-primary);" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<p class="text-xs" style="color:var(--gg-text-dim);">Sol and Eden are named context fixtures only at this stage. The screen uses controller-owned examples and does not load or parse either system's JSON.</p>
