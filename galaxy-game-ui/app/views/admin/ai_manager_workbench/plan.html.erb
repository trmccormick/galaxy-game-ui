<div class="mb-5"><p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Plan review / <%= @plan[:id] %></p><h1 class="gg-section-title">Proposed plan</h1><p class="text-sm" style="color:var(--gg-text-secondary);"><%= @task[:title] %> · <%= @task[:target] %></p></div>
<div class="gg-grid-panel mb-4"><div class="flex justify-between gap-3"><h2 class="gg-section-title text-lg">Plan summary</h2><span class="text-xs" style="color:var(--gg-accent-warning);"><%= @plan[:status] %></span></div><p class="text-sm"><%= @plan[:summary] %></p></div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
  <section class="gg-grid-panel"><h2 class="gg-section-title text-lg">Proposed steps</h2><ol class="space-y-3"><% @plan[:steps].each_with_index do |step, i| %><li class="flex gap-3"><span class="font-mono text-sm" style="color:var(--gg-primary);">0<%= i + 1 %></span><div><div class="text-sm font-semibold"><%= step[:title] %></div><p class="text-xs mt-1" style="color:var(--gg-text-secondary);"><%= step[:detail] %></p><span class="text-xs" style="color:var(--gg-text-dim);"><%= step[:status] %></span></div></li><% end %></ol></section>
  <section class="gg-grid-panel"><h2 class="gg-section-title text-lg">Resources & alternatives</h2><h3 class="text-xs uppercase mb-2" style="color:var(--gg-text-dim);">Resource assessment</h3><% @plan[:resources].each do |resource| %><div class="flex justify-between gap-3 py-2 border-b text-sm" style="border-color:rgba(0,212,255,.1);"><span><%= resource[:name] %></span><span style="color:var(--gg-text-secondary);"><%= resource[:quantity] %></span></div><% end %><h3 class="text-xs uppercase mt-4 mb-2" style="color:var(--gg-text-dim);">Alternatives</h3><ul class="list-disc pl-5 space-y-1 text-sm"><% @plan[:alternatives].each do |alternative| %><li><%= alternative %></li><% end %></ul></section>
</div>
<div class="gg-grid-panel"><h2 class="gg-section-title text-lg">Operator review</h2><p class="text-xs mb-3" style="color:var(--gg-text-secondary);">Controls are illustrative only; no decision is persisted and no simulation action is triggered.</p><div class="flex flex-wrap gap-2"><button type="button" class="px-4 py-2 rounded text-sm" style="background:rgba(6,255,165,.12);color:var(--gg-accent-success);">Approve (mock)</button><button type="button" class="px-4 py-2 rounded text-sm" style="background:rgba(255,0,110,.1);color:var(--gg-accent-danger);">Reject (mock)</button><button type="button" class="px-4 py-2 rounded text-sm" style="background:rgba(255,214,10,.1);color:var(--gg-accent-warning);">Defer (mock)</button></div></div>
