<div class="flex items-start justify-between gap-3 mb-5">
  <div><p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Task detail / <%= @task[:id] %></p><h1 class="gg-section-title"><%= @task[:title] %></h1><p class="text-sm" style="color:var(--gg-text-secondary);"><%= @task[:target] %> · <%= @task[:target_type] %></p></div>
  <%= link_to "← Task queue", admin_ai_manager_workbench_path(system: @task[:system_id]), class: "text-xs", style: "color:var(--gg-primary);" %>
</div>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
  <section class="gg-grid-panel lg:col-span-2">
    <h2 class="gg-section-title text-lg">Why this task exists</h2>
    <p class="text-sm mb-3"><%= @task[:rationale] %></p>
    <div class="grid grid-cols-2 gap-3 text-sm">
      <div><div class="gg-stat-label">Origin</div><strong><%= @task[:origin] %></strong></div>
      <div><div class="gg-stat-label">Governing source</div><strong><%= @task[:source] %></strong></div>
      <div><div class="gg-stat-label">Authority</div><strong><%= @task[:owner] %></strong></div>
      <div><div class="gg-stat-label">Last updated</div><strong><%= @task[:updated] %></strong></div>
    </div>
  </section>
  <section class="gg-grid-panel"><h2 class="gg-section-title text-lg">Task state</h2><div class="gg-metric text-2xl"><%= @task[:status].humanize %></div><div class="gg-stat-label mt-2">Priority: <%= @task[:priority].humanize %></div><div class="gg-stat-label mt-1">Category: <%= @task[:category] %></div></section>
</div>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5">
  <section class="gg-grid-panel"><h2 class="gg-section-title text-lg">Constraints</h2><ul class="list-disc pl-5 space-y-2 text-sm"><% @task[:constraints].each do |item| %><li><%= item %></li><% end %><% if @task[:constraints].empty? %><li>None specified in this fixture.</li><% end %></ul></section>
  <section class="gg-grid-panel"><h2 class="gg-section-title text-lg">Dependencies</h2><ul class="list-disc pl-5 space-y-2 text-sm"><% @task[:dependencies].each do |item| %><li><%= item %></li><% end %><% if @task[:dependencies].empty? %><li>No dependencies listed.</li><% end %></ul></section>
</div>
<div class="flex flex-wrap gap-3"><%= link_to "Review proposed plan →", admin_ai_manager_workbench_plan_path(@task[:id]), class: "px-4 py-2 rounded text-sm font-semibold", style: "background:rgba(0,212,255,.12);color:var(--gg-primary);border:1px solid rgba(0,212,255,.3);" %><%= link_to "Execution view", admin_ai_manager_workbench_execution_path(@task[:id]), class: "px-4 py-2 rounded text-sm", style: "border:1px solid rgba(0,212,255,.2);color:var(--gg-text-secondary);" %></div>
