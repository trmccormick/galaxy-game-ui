<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Task detail / <%= @task[:id] %></p>
    <h1 class="gg-section-title"><%= @task[:title] %></h1>
    <p class="text-sm" style="color:var(--gg-text-secondary);"><%= @system[:name] %> · <%= @task[:target] %> · <%= @task[:target_type] %></p>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= link_to "← Overview", admin_ai_manager_path(system: @task[:system_id]), class: "text-xs", style: "color:var(--gg-primary);" %>
    <%= link_to "Task queue", admin_ai_manager_workbench_path(system: @task[:system_id]), class: "text-xs", style: "color:var(--gg-primary);" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">
  <section class="gg-grid-panel lg:col-span-2">
    <h2 class="gg-section-title text-lg">Why this task exists</h2>
    <p class="text-sm mb-3"><%= @task[:rationale] %></p>
    <div class="grid grid-cols-2 gap-3 text-sm">
      <div><div class="gg-stat-label">Origin</div><strong><%= @task[:origin] %></strong></div>
      <div><div class="gg-stat-label">Governing source</div><strong><%= @task[:source] %></strong></div>
      <div><div class="gg-stat-label">Operating authority</div><strong><%= @task[:owner] %></strong></div>
      <div><div class="gg-stat-label">Last updated</div><strong><%= @task[:updated] %></strong></div>
    </div>
  </section>
  <section class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Task state</h2>
    <div class="gg-metric text-2xl"><%= @task[:status_label] %></div>
    <div class="gg-stat-label mt-2">Priority: <%= @task[:priority].humanize %></div>
    <div class="gg-stat-label mt-1">Category: <%= @task[:category] %></div>
    <div class="gg-stat-label mt-3">Target ID</div>
    <div class="text-xs font-mono"><%= @task[:target_id] %></div>
  </section>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5">
  <section class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Constraints & policies</h2>
    <ul class="list-disc pl-5 space-y-2 text-sm">
      <% @task[:constraints].each do |item| %><li><%= item %></li><% end %>
      <% if @task[:constraints].empty? %><li>None specified in this fixture.</li><% end %>
    </ul>
  </section>
  <section class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Dependencies</h2>
    <ul class="list-disc pl-5 space-y-2 text-sm">
      <% @task[:dependencies].each do |item| %><li><%= item %></li><% end %>
      <% if @task[:dependencies].empty? %><li>No dependencies listed.</li><% end %>
    </ul>
  </section>
</div>

<% if @task[:procedure] %>
  <section class="gg-grid-panel mb-5">
    <div class="flex flex-wrap justify-between gap-2 mb-3">
      <div><h2 class="gg-section-title text-lg mb-1">Linked execution procedure</h2><p class="text-xs" style="color:var(--gg-text-secondary);">Reusable task definition · not the strategic decision that selected it</p></div>
      <span class="text-xs font-mono" style="color:var(--gg-primary);"><%= @task[:procedure][:id] %> · v<%= @task[:procedure][:version] %></span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
      <div><div class="gg-stat-label">Procedure type</div><div class="text-sm"><%= @task[:procedure][:type].humanize %></div></div>
      <div><div class="gg-stat-label">Craft</div><div class="text-sm"><%= @task[:procedure][:craft_type].humanize %></div></div>
      <div><div class="gg-stat-label">Transit in definition</div><div class="text-sm"><%= @task[:procedure][:transit_days] %> days</div></div>
      <div><div class="gg-stat-label">Payload source</div><div class="text-sm"><%= @task[:procedure][:source_gases].join(", ") %></div></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <h3 class="text-xs uppercase mb-2" style="color:var(--gg-text-dim);">Arrival payload</h3>
        <% @task[:procedure][:payload].each do |item| %>
          <div class="flex justify-between py-1 text-sm border-b" style="border-color:rgba(0,212,255,.1);"><span><%= item[:name] %></span><strong><%= item[:amount] %> <%= item[:unit] %></strong></div>
        <% end %>
      </div>
      <div>
        <h3 class="text-xs uppercase mb-2" style="color:var(--gg-text-dim);">Receiving requirements</h3>
        <ul class="list-disc pl-5 space-y-1 text-sm"><% @task[:procedure][:offload_requirements].each do |item| %><li><%= item %></li><% end %></ul>
      </div>
    </div>
  </section>
<% end %>

<div class="flex flex-wrap gap-3">
  <%= link_to "Review proposed plan →", admin_ai_manager_workbench_plan_path(@task[:id]), class: "px-4 py-2 rounded text-sm font-semibold", style: "background:rgba(0,212,255,.12);color:var(--gg-primary);border:1px solid rgba(0,212,255,.3);" %>
  <%= link_to "Execution view", admin_ai_manager_workbench_execution_path(@task[:id]), class: "px-4 py-2 rounded text-sm", style: "border:1px solid rgba(0,212,255,.2);color:var(--gg-text-secondary);" %>
</div>
