<div class="mb-5"><p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Execution monitor / <%= @execution[:id] %></p><h1 class="gg-section-title">Execution status</h1><p class="text-sm" style="color:var(--gg-text-secondary);"><%= @task[:title] %> · <%= @task[:target] %></p></div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4"><div class="gg-grid-panel"><div class="gg-stat-label">Status</div><div class="text-lg font-semibold mt-2"><%= @execution[:status] %></div></div><div class="gg-grid-panel"><div class="gg-stat-label">Assigned group</div><div class="text-lg font-semibold mt-2"><%= @execution[:asset] %></div></div><div class="gg-grid-panel"><div class="gg-stat-label">Illustrative progress</div><div class="gg-metric"><%= @execution[:progress] %>%</div></div></div>
<section class="gg-grid-panel"><h2 class="gg-section-title text-lg">Activity</h2><ol class="space-y-3"><% @execution[:events].each do |event| %><li class="text-sm border-l-2 pl-3 py-1" style="border-color:var(--gg-primary);"><%= event %></li><% end %></ol><p class="text-xs mt-4" style="color:var(--gg-text-dim);">Mock execution record only. No assets are dispatched and no game state is modified.</p></section>
<div class="mt-4"><%= link_to "← Return to task", admin_ai_manager_workbench_task_path(@task[:id]), class: "text-sm", style: "color:var(--gg-primary);" %></div>
