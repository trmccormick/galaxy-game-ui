<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <p class="text-xs uppercase tracking-widest" style="color:var(--gg-text-dim);">Admin / AI Manager / Mission profile</p>
    <h1 class="gg-section-title"><%= @profile["name"] %></h1>
    <p class="text-xs font-mono mt-1" style="color:var(--gg-text-dim);"><%= @profile["id"] %></p>
  </div>
  <span class="text-xs px-3 py-2 rounded" style="background:rgba(255,190,11,.10);color:var(--gg-accent-warning);">Session draft · not an executing mission</span>
</div>

<section class="gg-grid-panel mb-4">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div><div class="gg-stat-label mb-1">Target</div><div class="text-sm font-semibold"><%= @profile["target_body"] %></div></div>
    <div><div class="gg-stat-label mb-1">Based on template</div><div class="text-sm"><%= @profile["template_name"] %></div></div>
    <div><div class="gg-stat-label mb-1">Template maturity</div><div class="text-sm" style="color:var(--gg-accent-warning);"><%= @profile["source_maturity"] %></div></div>
  </div>
  <div class="mt-4 pt-4 border-t" style="border-color:rgba(0,212,255,.12);">
    <div class="gg-stat-label mb-1">Operational objective</div>
    <p class="text-sm"><%= @profile["objective"] %></p>
  </div>
</section>

<section class="gg-grid-panel mb-4">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <h2 class="gg-section-title text-lg">Profile task plan</h2>
    <span class="text-xs" style="color:var(--gg-text-dim);"><%= @profile["tasks"].length %> selected task groupings</span>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-xs uppercase" style="color:var(--gg-text-dim);"><th class="py-2 pr-3">Sequence</th><th class="py-2 pr-3">Task grouping</th><th class="py-2 pr-3">Responsibility</th><th class="py-2">Proposed assignment</th></tr></thead>
      <tbody>
        <% @profile["tasks"].each_with_index do |task, index| %>
          <tr class="border-t align-top" style="border-color:rgba(0,212,255,.12);">
            <td class="py-3 pr-3 font-mono" style="color:var(--gg-primary);"><%= (index + 1).to_s.rjust(2, "0") %></td>
            <td class="py-3 pr-3"><div class="font-semibold"><%= task["name"] %></div><div class="text-xs mt-1" style="color:var(--gg-text-dim);"><%= task["status"] %></div></td>
            <td class="py-3 pr-3 text-xs" style="color:var(--gg-text-secondary);"><%= task["role"] %></td>
            <td class="py-3 text-xs"><%= task["assigned_asset"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
  <section class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Profile lifecycle</h2>
    <ol class="space-y-2 text-xs mt-3" style="color:var(--gg-text-secondary);">
      <li><span style="color:var(--gg-accent-success);">✓</span> Template selected</li>
      <li><span style="color:var(--gg-accent-success);">✓</span> Target and objective configured</li>
      <li><span style="color:var(--gg-accent-success);">✓</span> Task groupings and proposed assignments selected</li>
      <li><span style="color:var(--gg-text-dim);">○</span> Dependency and live-world validation — not connected</li>
      <li><span style="color:var(--gg-text-dim);">○</span> Execution authorization and dispatch — not connected</li>
      <li><span style="color:var(--gg-text-dim);">○</span> Authoritative outcome verification — not connected</li>
    </ol>
  </section>
  <section class="gg-grid-panel">
    <h2 class="gg-section-title text-lg">Draft boundary</h2>
    <p class="text-sm mt-2" style="color:var(--gg-text-secondary);">This profile is stored in the Rails browser session only. It is not written to the GalaxyGame database, does not create a mission run, and does not dispatch or modify any game assets.</p>
    <p class="text-xs mt-3" style="color:var(--gg-text-dim);">Created <%= Time.iso8601(@profile["created_at"]).strftime("%Y-%m-%d %H:%M UTC") %></p>
  </section>
</div>

<div class="flex flex-wrap gap-3">
  <%= link_to "Build another profile", admin_ai_manager_new_profile_path(template_id: @profile["template_id"]), class: "rounded px-4 py-2 text-sm font-semibold", style: "background:rgba(0,212,255,.12);color:var(--gg-primary);border:1px solid rgba(0,212,255,.24);" %>
  <%= link_to "Open task workbench", admin_ai_manager_workbench_path, class: "rounded px-4 py-2 text-sm border", style: "border-color:rgba(0,212,255,.2);color:var(--gg-text-secondary);" %>
  <%= link_to "Mission template library", admin_ai_manager_library_missions_path, class: "text-sm self-center", style: "color:var(--gg-text-secondary);" %>
</div>
