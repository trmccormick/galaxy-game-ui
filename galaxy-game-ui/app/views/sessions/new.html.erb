<% content_for :title, "Sign in — Galaxy Game" %>

<div class="mx-auto max-w-md">
  <div class="rounded-lg border border-[rgba(0,212,255,0.4)] bg-[var(--gg-bg-panel)] p-8 shadow-sm">
    <h1 class="text-2xl font-bold text-[var(--gg-text-primary)]">Sign in</h1>
    <p class="mt-1 mb-6 text-sm text-[var(--gg-text-secondary)]">
      Sign in to continue
    </p>

    <%= form_with url: session_path do |form| %>
      <div class="space-y-4">
        <div>
          <%= form.label :email_address, class: "mb-1.5 block text-sm font-semibold text-[var(--gg-text-primary)]" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                placeholder: "Enter your email address", value: params[:email_address],
                class: "w-full rounded-lg border border-[rgba(0,212,255,0.3)] bg-[var(--gg-bg-dark)] px-4 py-3.5 text-base text-[var(--gg-text-primary)] placeholder:text-[var(--gg-text-dim)] focus:border-[var(--gg-primary)] focus:ring-2 focus:ring-[rgba(0,212,255,0.3)] outline-none" %>
        </div>

        <div>
          <%= form.label :password, class: "mb-1.5 block text-sm font-semibold text-[var(--gg-text-primary)]" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password",
                placeholder: "Enter your password", maxlength: 72,
                class: "w-full rounded-lg border border-[rgba(0,212,255,0.3)] bg-[var(--gg-bg-dark)] px-4 py-3.5 text-base text-[var(--gg-text-primary)] placeholder:text-[var(--gg-text-dim)] focus:border-[var(--gg-primary)] focus:ring-2 focus:ring-[rgba(0,212,255,0.3)] outline-none" %>
        </div>

        <%= form.submit "Sign in",
              class: "w-full rounded-lg bg-[var(--gg-primary)] px-6 py-3.5 text-base font-semibold text-[#0a0a0a] shadow transition-colors hover:brightness-110" %>
      </div>
    <% end %>

    <div class="mt-5 text-center">
      <%= link_to "Forgot password?", new_password_path,
            class: "text-sm font-medium text-[var(--gg-primary)] hover:underline" %>
    </div>
  </div>
</div>