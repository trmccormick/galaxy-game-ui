<% content_for :title, "Donor Check-In — WVU Libraries Systems" %>

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold text-wvu-blue">Donor Check-In</h1>
    <p class="text-wvu-warm-gray-medium mt-1">
      Type a surname to instantly filter the list, then tap a donor to confirm their details.
    </p>
  </div>
  <div>
    <%= link_to "Export CSV", graduate_records_path(format: :csv), 
          class: "inline-flex items-center rounded-lg bg-wvu-accent-blue px-4 py-2.5 text-sm font-semibold text-white shadow hover:bg-wvu-gold hover:text-wvu-blue transition-colors" %>
  </div>
</div>

<!-- Wrap the search and list in the Stimulus controller -->
<div data-controller="graduate-filter" class="space-y-6">
  
  <!-- Live Client-Side Search Input -->
  <div class="mb-6">
    <input type="text" 
           data-graduate-filter-target="input" 
           data-action="input->graduate-filter#filter" 
           placeholder="Start typing a surname… (filters instantly)"
           aria-label="Search by surname" 
           autofocus
           class="w-full rounded-lg border border-wvu-warm-gray-light bg-white px-5 py-4 text-lg focus:border-wvu-accent-blue focus:ring-2 focus:ring-wvu-accent-blue/30 outline-none shadow-sm">
  </div>

  <!-- Full List Shown by Default, Filtered Instantly -->
  <ul class="space-y-3">
    <% @graduate_records.each do |record| %>
      <li data-graduate-filter-target="item">
        <%= link_to graduate_record_path(record),
              class: "flex items-center justify-between gap-4 rounded-lg border border-wvu-warm-gray-light bg-white p-5 shadow-sm hover:border-wvu-accent-blue hover:shadow transition-colors" do %>
          <span class="min-w-0">
            <span class="block text-lg font-semibold text-wvu-blue truncate"><%= record.display_name %></span>
            <span class="block text-sm text-wvu-warm-gray-medium truncate">
              <%= [record.primary_constituency, record.class_year].compact.join(" · ") %>
            </span>
          </span>
          <span class="shrink-0 rounded bg-wvu-accent-blue px-4 py-2.5 text-sm font-semibold text-white">Open →</span>
        <% end %>
      </li>
    <% end %>
  </ul>

</div>