<% content_for :title, "#{@graduate_record.display_name} — Donor Check-In" %>

<div class="mb-6 flex items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold text-wvu-blue"><%= @graduate_record.display_name %></h1>
    <p class="text-wvu-warm-gray-medium mt-1">Confirm this information with the donor.</p>
  </div>
  <%= link_to "← Back to search", graduate_records_path, class: "font-semibold text-wvu-accent-blue hover:underline" %>
</div>

<%= form_with model: @graduate_record, method: :patch, class: "space-y-6" do |f| %>
  <!-- Prepopulated demographic information (read-only, from the CSV) -->
  <section class="rounded-lg border border-wvu-warm-gray-light bg-white shadow-sm">
    <div class="border-b border-wvu-warm-gray-light px-5 py-4">
      <h2 class="text-lg font-semibold text-wvu-blue">Donor Information</h2>
      <p class="text-sm text-wvu-warm-gray-medium">Prepopulated — please verify with the donor.</p>
    </div>
    <dl class="grid grid-cols-1 sm:grid-cols-2">
      <div class="px-5 py-4 sm:border-r sm:border-wvu-warm-gray-light">
        <dt class="text-sm font-semibold uppercase tracking-wide text-wvu-warm-gray-medium">Combined Name</dt>
        <dd class="mt-1 text-lg font-semibold text-wvu-blue"><%= @graduate_record.combined_name %></dd>
      </div>
      <div class="px-5 py-4">
        <dt class="text-sm font-semibold uppercase tracking-wide text-wvu-warm-gray-medium">Primary Constituency</dt>
        <dd class="mt-1 text-lg text-wvu-warm-gray-dark"><%= @graduate_record.primary_constituency.presence || "—" %></dd>
      </div>
      <div class="px-5 py-4 sm:border-r sm:border-wvu-warm-gray-light">
        <dt class="text-sm font-semibold uppercase tracking-wide text-wvu-warm-gray-medium">Educational / College Code</dt>
        <dd class="mt-1 text-lg text-wvu-warm-gray-dark"><%= @graduate_record.college_code.presence || "—" %></dd>
      </div>
      <div class="px-5 py-4">
        <dt class="text-sm font-semibold uppercase tracking-wide text-wvu-warm-gray-medium">Educational Sub-Department Code</dt>
        <dd class="mt-1 text-lg text-wvu-warm-gray-dark"><%= @graduate_record.sub_department_code.presence || "—" %></dd>
      </div>
      <div class="px-5 py-4 sm:col-span-2 sm:border-t sm:border-wvu-warm-gray-light">
        <dt class="text-sm font-semibold uppercase tracking-wide text-wvu-warm-gray-medium">Class Year</dt>
        <dd class="mt-1 text-lg text-wvu-warm-gray-dark"><%= @graduate_record.class_year.presence || "—" %></dd>
      </div>
    </dl>
  </section>

  <!-- Release / Waiver -->
  <section class="rounded-lg border border-wvu-warm-gray-light bg-white p-5 shadow-sm">
    <label class="flex cursor-pointer items-start gap-4">
      <%= f.check_box :waiver_completed,
            class: "mt-1 h-8 w-8 shrink-0 rounded border-wvu-warm-gray-medium text-wvu-accent-blue focus:ring-wvu-accent-blue/40" %>
      <span>
        <span class="block text-lg font-semibold text-wvu-blue">Release / Waiver completed</span>
        <span class="mt-1 block text-sm text-wvu-warm-gray-medium">
          Check once the donor's release or waiver has been completed.
        </span>
      </span>
    </label>
  </section>

  <!-- Corrections / Notes -->
  <section class="rounded-lg border border-wvu-warm-gray-light bg-white p-5 shadow-sm">
    <label for="graduate_record_notes" class="block text-lg font-semibold text-wvu-blue">Corrections / Notes</label>
    <p class="mb-3 mt-1 text-sm text-wvu-warm-gray-medium">
      Record any demographic corrections, preferred-name changes, or other information to reconcile after the event.
    </p>
    <%= f.text_area :notes, rows: 4,
          placeholder: "e.g. Preferred name is “Sam”. Update constituency to Ohio.",
          class: "w-full rounded-lg border border-wvu-warm-gray-light px-4 py-3.5 text-base focus:border-wvu-accent-blue focus:ring-2 focus:ring-wvu-accent-blue/30 outline-none" %>
  </section>

  <!-- Actions -->
  <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">
    <%= link_to "Cancel", graduate_records_path,
          class: "rounded-lg px-6 py-4 text-center font-semibold text-wvu-warm-gray-dark hover:bg-wvu-blue/5 transition-colors" %>
    <%= f.submit "Save & Next Donor",
          class: "rounded-lg bg-wvu-accent-blue px-8 py-4 text-base font-semibold text-white shadow hover:bg-wvu-gold hover:text-wvu-blue transition-colors" %>
  </div>
<% end %>
