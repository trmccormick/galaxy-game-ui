<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "WVU Libraries Systems" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WVU Libraries Systems">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-wvu-warm-gray-light">
    <!-- WVU masthead (matches internal systems apps: wvu-blue bar + co-branding) -->
    <header class="bg-wvu-blue text-white">
      <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between gap-4">
        <a href="https://library.wvu.edu/" class="flex items-center gap-3">
          <span class="text-2xl font-bold tracking-tight">Libraries</span>
          <span class="border-l border-white/40 pl-3 text-sm uppercase tracking-widest text-white/90">
            Libraries Systems
          </span>
        </a>
        <nav class="flex items-center gap-3 text-sm">
          <% if authenticated? %>
            <span class="hidden sm:inline text-white/80"><%= Current.user&.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete,
                  class: "rounded px-4 py-2.5 bg-white/10 hover:bg-wvu-gold hover:text-wvu-blue font-semibold transition-colors" %>
          <% else %>
            <%= link_to "Sign in", new_session_path,
                  class: "rounded px-4 py-2.5 bg-white/10 hover:bg-wvu-gold hover:text-wvu-blue font-semibold transition-colors" %>
          <% end %>
        </nav>
      </div>
      <!-- Gold accent rule -->
      <div class="h-1 bg-wvu-gold"></div>
    </header>

    <!-- Main content -->
    <main class="flex-1 woodburn-hall">
      <div class="mx-auto max-w-5xl px-4 py-6 sm:py-8">
        <!-- Flash messages -->
        <% if notice.present? %>
          <div class="mb-5 rounded border-l-4 border-wvu-accent-blue bg-white p-4 shadow-sm text-wvu-warm-gray-dark">
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="mb-5 rounded border-l-4 border-wvu-old-gold bg-white p-4 shadow-sm text-wvu-warm-gray-dark">
            <%= alert %>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <!-- Footer (matches banner color) -->
    <footer class="bg-wvu-blue text-white">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <address class="not-italic">
            <a href="https://library.wvu.edu/" class="hover:text-wvu-gold"><strong>WVU Libraries</strong></a><br>
            West Virginia University<br>
            1549 University Ave. | P.O. Box 6069<br>
            Morgantown, WV 26506-6069<br>
            Phone: <a href="tel:13042934040" class="hover:text-wvu-gold">1-304-293-4040</a><br>
            Fax: 1-304-293-6638<br>
            Email: <a href="mailto:LibraryDeanOffice@mail.wvu.edu" class="hover:text-wvu-gold">LibraryDeanOffice@mail.wvu.edu</a>
          </address>
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            <a class="hover:text-wvu-gold" href="https://www.wvu.edu/SiteIndex/">A-Z Site Index</a>
            <a class="hover:text-wvu-gold" href="https://campusmap.wvu.edu">Campus Map</a>
            <a class="hover:text-wvu-gold" href="https://directory.wvu.edu">WVU Directory</a>
            <a class="hover:text-wvu-gold" href="https://portal.wvu.edu">WVU Portal</a>
          </div>
        </div>
        <p class="mt-4 text-white/70">
          &copy; <%= Date.current.year %>
          <a class="hover:text-wvu-gold" href="https://www.wvu.edu/">West Virginia University</a>.
          WVU is an EEO/Affirmative Action employer — Minority/Female/Disability/Veteran.
        </p>
      </div>
    </footer>
  </body>
</html>
